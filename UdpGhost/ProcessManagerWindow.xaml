<Window x:Class="UdpGhost.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程进程管理" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#C9D1D9"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C2128"/>
                    <Setter Property="BorderBrush" Value="#00FF41"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：目标信息 + 搜索 + 刷新 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TargetInfo" Text="目标: --" Foreground="#00FF41" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Height="26" Background="#0D1117" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" FontFamily="Consolas" FontSize="11" Padding="4,2" TextChanged="SearchBox_TextChanged" ToolTip="按进程名搜索"/>
                <Button x:Name="RefreshBtn" Grid.Column="1" Content="[刷新]" Style="{StaticResource HackerButton}" Height="26" Margin="6,0,0,0" Click="RefreshBtn_Click"/>
                <Button x:Name="KillBtn" Grid.Column="2" Content="[结束进程]" Style="{StaticResource HackerButton}" Height="26" Margin="6,0,0,0" Foreground="#FF6B6B" Click="KillBtn_Click"/>
            </Grid>
        </StackPanel>

        <!-- 进程列表 -->
        <ListView x:Name="ProcessListView" Grid.Row="1" Background="#0D1117" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" FontFamily="Consolas" FontSize="11">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding PID}"/>
                    <GridViewColumn Header="进程名" Width="140" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="内存(MB)" Width="70" DisplayMemberBinding="{Binding Memory}"/>
                    <GridViewColumn Header="用户" Width="120" DisplayMemberBinding="{Binding User}"/>
                    <GridViewColumn Header="描述" Width="180" DisplayMemberBinding="{Binding Description}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 底部：状态 -->
        <TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪" Foreground="#8B949E" FontFamily="Consolas" FontSize="10" Margin="0,6,0,0"/>
    </Grid>
</Window>
