<Window x:Class="UdpGhost.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程文件管理" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#C9D1D9"
        FontFamily="Consolas" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C2128"/>
                    <Setter Property="BorderBrush" Value="#00FF41"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="[上级]" Width="60" Height="26" Click="BtnUp_Click" Style="{StaticResource HackerButton}" Margin="0,0,5,0"/>
            <Button Content="[进入]" Width="60" Height="26" Click="BtnEnter_Click" Style="{StaticResource HackerButton}" Margin="0,0,5,0"/>
            <Button Content="[刷新]" Width="60" Height="26" Click="BtnRefresh_Click" Style="{StaticResource HackerButton}" Margin="0,0,5,0"/>
            <TextBlock Text="路径:" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="#8B949E"/>
            <TextBox x:Name="PathBox" Height="26" Width="340" Background="#161B22" Foreground="#C9D1D9" BorderBrush="#00FF41" BorderThickness="1" Padding="4" FontSize="11" KeyDown="PathBox_KeyDown"/>
        </StackPanel>

        <!-- 主体：左侧快捷目录 + 右侧文件列表 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧快捷目录 -->
            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Margin="0,0,5,0">
                <StackPanel Margin="6">
                    <TextBlock Text="快捷目录" Foreground="#00FF41" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button Content="桌面" Height="24" Click="Shortcut_Click" Tag="Desktop" Style="{StaticResource HackerButton}" Margin="0,2" FontSize="10"/>
                    <Button Content="文档" Height="24" Click="Shortcut_Click" Tag="Documents" Style="{StaticResource HackerButton}" Margin="0,2" FontSize="10"/>
                    <Button Content="下载" Height="24" Click="Shortcut_Click" Tag="Downloads" Style="{StaticResource HackerButton}" Margin="0,2" FontSize="10"/>
                    <Button Content="TEMP" Height="24" Click="Shortcut_Click" Tag="Temp" Style="{StaticResource HackerButton}" Margin="0,2" FontSize="10"/>
                    <Button Content="C:\" Height="24" Click="Shortcut_Click" Tag="C:\" Style="{StaticResource HackerButton}" Margin="0,2" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- 右侧文件列表 -->
            <Border Grid.Column="1" Background="#161B22" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="4">
                <ListView x:Name="FileList" Background="Transparent" Foreground="#C9D1D9" BorderThickness="0" FontSize="11" MouseDoubleClick="FileList_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D">
                            <MenuItem Header="下载" Click="MenuDownload_Click" Foreground="#00FF41"/>
                            <MenuItem Header="删除" Click="MenuDelete_Click" Foreground="#FF6B6B"/>
                            <Separator Background="#30363D"/>
                            <MenuItem Header="刷新" Click="MenuRefresh_Click" Foreground="#8B949E"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="名称" Width="250" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding Time}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- 底部操作栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="[上传文件]" Width="80" Height="26" Click="BtnUpload_Click" Style="{StaticResource HackerButton}" Margin="0,0,5,0"/>
            <Button Content="[下载选中]" Width="80" Height="26" Click="BtnDownload_Click" Style="{StaticResource HackerButton}" Margin="0,0,5,0"/>
            <Button Content="[删除]" Width="60" Height="26" Click="BtnDelete_Click" Style="{StaticResource HackerButton}" Foreground="#FF6B6B" Margin="0,0,5,0"/>
            <Button Content="[新建文件夹]" Width="90" Height="26" Click="BtnMkdir_Click" Style="{StaticResource HackerButton}" Margin="0,0,5,0"/>
            <CheckBox x:Name="ChkSystem" Content="SYSTEM权限" Foreground="#8B949E" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="StatusBar" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#6E7681" FontSize="10"/>
        </StackPanel>
    </Grid>
</Window>
