<Window x:Class="UdpGhost.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发消息" Height="200" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Opacity="0">
    <Border CornerRadius="10" Background="#E60D1117" BorderBrush="#00FF41" BorderThickness="1.5">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="[ 发消息 ] (最多20字, 回车发送)" Foreground="#00FF41" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" x:Name="MsgBox" Background="#1F2937" Foreground="#00FF41" BorderBrush="#30363D" BorderThickness="1"
                     FontFamily="Consolas" FontSize="12" Padding="8,6" CaretBrush="#00FF41" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxLength="40"
                     PreviewKeyDown="MsgBox_PreviewKeyDown"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="[发送]" Width="70" Height="28" Margin="5,0,0,0" Click="Send_Click"
                        Background="#00FF41" Foreground="#0D1117" BorderThickness="0" FontFamily="Consolas" FontSize="12" Cursor="Hand">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                </Button>
                <Button Content="[取消]" Width="70" Height="28" Margin="5,0,0,0" Click="Cancel_Click"
                        Background="#1F2937" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1" FontFamily="Consolas" FontSize="12" Cursor="Hand">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
