<Window x:Class="UdpGhost.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕监控" Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="#0D1117"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Background="#E60D1117" BorderBrush="#00FF41" BorderThickness="1.5">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="▓ 屏幕监控 // DolbyVision" Foreground="#00FF41" FontSize="14" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                <Button Content="×" Width="30" Height="24" Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontFamily="Consolas" FontSize="14" Cursor="Hand" HorizontalAlignment="Right" Click="Close_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="[扫描]" Style="{StaticResource HackerButton}" Width="70" Click="Scan_Click"/>
                    <TextBlock Text="在线设备:" Foreground="#8B949E" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Margin="15,0,5,0"/>
                    <TextBlock x:Name="CountText" Text="0" Foreground="#00FF41" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5">
                        <ListBox x:Name="SenderList" Background="#161B22" Foreground="#C9D1D9" BorderThickness="0" FontFamily="Consolas" FontSize="12" MouseDoubleClick="SenderList_DoubleClick"/>
                    </Border>
                    <Border Grid.Row="1" Background="#161B22" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,5,0,0">
                        <StackPanel>
                            <TextBlock Text="── 远程控制 ──" Foreground="#00FF41" FontFamily="Consolas" FontSize="11" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2" Rows="4">
                                <Button Content="[关机]" Style="{StaticResource HackerButton}" Height="26" FontSize="11" Margin="0,0,3,3" Click="RemoteShutdown_Click"/>
                                <Button Content="[重启]" Style="{StaticResource HackerButton}" Height="26" FontSize="11" Margin="3,0,0,3" Click="RemoteReboot_Click"/>
                                <Button Content="[命令]" Style="{StaticResource HackerButton}" Height="26" FontSize="11" Margin="0,3,3,0" Click="RemoteCmd_Click"/>
                                <Button Content="[观看]" Style="{StaticResource HackerButton}" Height="26" FontSize="11" Margin="3,3,0,0" Click="RemoteWatch_Click"/>
                                <Button Content="[CMD终端]" Style="{StaticResource HackerButton}" Height="26" FontSize="11" Margin="0,3,3,0" Click="RemoteCmdTerminal_Click"/>
                                <Button Content="[PS终端]" Style="{StaticResource HackerButton}" Height="26" FontSize="11" Margin="3,3,0,0" Click="RemotePsTerminal_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Column="2" Background="#000000" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5">
                    <Image x:Name="VideoImage" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
