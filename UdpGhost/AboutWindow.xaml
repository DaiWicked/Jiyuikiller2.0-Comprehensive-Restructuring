<Window x:Class="UdpGhost.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 UdpGhost" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="#0D1117"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Background="#E60D1117" BorderBrush="#00FF41" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="▓" Foreground="#00FF41" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Text="UdpGhost" Foreground="#00FF41" FontSize="22" FontWeight="Bold" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Foreground="#8B949E" FontFamily="Consolas" FontSize="12">
                <StackPanel>
                    <TextBlock Text="版本: QD_V3.1_JiYuRebuild_Funny" Foreground="#00FF41" Margin="0,0,0,8"/>
                    <TextBlock Text="极域电子教室UDP伪造攻击工具" Foreground="#8B949E" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <TextBlock Text="功能模块:" Foreground="#00FF41" Margin="0,0,0,6" FontWeight="Bold"/>
                    <TextBlock Text="  • 单学生连接: 一对一指定学生端连接,单播发送指令" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="  • 指定IP攻击: 黑屏/解锁/发消息/发命令/关机/重启" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="  • 屏幕监控: 扫描DolbyVision发送端,实时观看+远程控制" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="  • 远程进程管理: 查看/结束被控端进程" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="  • 虚拟控制台: CMD/PowerShell远程终端" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="  • 恶搞功能: Win10/Win11 OOBE动画/封禁全屏" Foreground="#8B949E" Margin="0,0,0,12"/>
                    <TextBlock Text="被控端支持:" Foreground="#00FF41" Margin="0,0,0,6" FontWeight="Bold"/>
                    <TextBlock Text="  • DolbyVision: 基础版(普通模式+SYSTEM模式)" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <TextBlock Text="  • DolbyAccess: ANS增强版(自动安装+自恢复)" Foreground="#8B949E" Margin="0,0,0,12"/>
                    <TextBlock Text="本程序仅供学习研究使用,请勿用于非法用途。" Foreground="#FF6B6B" Margin="0,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <!-- 关闭按钮 -->
            <Button Grid.Row="2" Content="[关闭]" Style="{StaticResource HackerButton}" Width="100" HorizontalAlignment="Center" Margin="0,15,0,0" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
