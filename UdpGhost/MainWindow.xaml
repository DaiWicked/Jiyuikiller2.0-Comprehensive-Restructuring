<Window x:Class="UdpGhost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UdpGhost" Height="560" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="#0D1117"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HackerInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#00FF41"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Background="#E60D1117" BorderBrush="#00FF41" BorderThickness="1.5">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="▓" Foreground="#00FF41" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="UdpGhost" Foreground="#00FF41" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="// QD_V2.7_JiYuRebuild_JustLikeThis" Foreground="#484F58" FontSize="11" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Width="30" Height="24" Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontFamily="Consolas" FontSize="14" Cursor="Hand" Click="Minimize_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button Content="×" Width="30" Height="24" Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontFamily="Consolas" FontSize="14" Cursor="Hand" Click="Close_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,5,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="频道:" Foreground="#8B949E" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"/>
                    <TextBox x:Name="ChannelBox" Text="1" Width="35" Style="{StaticResource HackerInput}" Margin="5,0,15,0"/>
                    <TextBlock Text="学生IP:" Foreground="#8B949E" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"/>
                    <TextBox x:Name="IpBox" Width="130" Style="{StaticResource HackerInput}" Margin="5,0,10,0"/>
                    <Button Content="[扫描]" Style="{StaticResource HackerButton}" Width="65" Click="Scan_Click"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5">
                    <ListBox x:Name="HostList" Background="#161B22" Foreground="#C9D1D9" BorderThickness="0" FontFamily="Consolas" FontSize="12" MouseDoubleClick="HostList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                </Border>
                <Border Grid.Column="2" Background="#161B22" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="5" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="[ 控制面板 ]" Foreground="#00FF41" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"/>
                            <Button Content="[黑屏]" Style="{StaticResource HackerButton}" Margin="0,2" Click="Blackscreen_Click"/>
                            <TextBox x:Name="BlackText" Style="{StaticResource HackerInput}" Margin="0,2" MaxLength="30" ToolTip="黑屏显示的文字(可选)"/>
                            <Button Content="[解锁]" Style="{StaticResource HackerButton}" Margin="0,2" Click="Unlock_Click"/>
                            <Button Content="[发消息]" Style="{StaticResource HackerButton}" Margin="0,2" Click="SendMsg_Click"/>
                            <Button Content="[关机]" Style="{StaticResource HackerButton}" Margin="0,2" Click="Shutdown_Click"/>
                            <Button Content="[重启]" Style="{StaticResource HackerButton}" Margin="0,2" Click="Reboot_Click"/>
                            <Button Content="[屏幕监控]" Style="{StaticResource HackerButton}" Margin="0,8,0,2" Click="Monitor_Click"/>
                            <Button Content="[部署监控端]" Style="{StaticResource HackerButton}" Margin="0,2" Click="Deploy_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,10">
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#00FF41" BorderThickness="0" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Hidden" Height="60"/>
            </Border>
            <TextBlock Grid.Row="4" Text="Status: Ready" Foreground="#484F58" FontFamily="Consolas" FontSize="10"/>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
