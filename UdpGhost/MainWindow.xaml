<Window x:Class="UdpGhost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UdpGhost" Height="620" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="#0D1117"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HackerInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#00FF41"/>
        </Style>
        <Style x:Key="HackerTab" TargetType="TabItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0D1117"/>
                                <Setter Property="Foreground" Value="#00FF41"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#00FF41"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10" Background="#E60D1117" BorderBrush="#00FF41" BorderThickness="1.5">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="▓" Foreground="#00FF41" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="UdpGhost" Foreground="#00FF41" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="// QD_V3.1_JiYuRebuild_Funny" Foreground="#484F58" FontSize="11" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Width="30" Height="24" Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontFamily="Consolas" FontSize="14" Cursor="Hand" Click="Minimize_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                    <Button Content="×" Width="30" Height="24" Background="Transparent" Foreground="#8B949E" BorderThickness="0" FontFamily="Consolas" FontSize="14" Cursor="Hand" Click="Close_Click">
                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- TabControl 三区分组 -->
            <TabControl Grid.Row="1" Grid.RowSpan="2" Background="Transparent" BorderThickness="0" Padding="0">
                <!-- ========== 第一区：单学生连接 ========== -->
                <TabItem Header="单学生连接" Style="{StaticResource HackerTab}">
                    <Border Background="#0D1117" BorderBrush="#00FF41" BorderThickness="1,0,1,1" CornerRadius="0,0,5,5" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左侧：设备列表 -->
                            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="8,6">
                                        <TextBlock Text="在线设备:" Foreground="#6E7681" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <Button Content="[扫描]" Style="{StaticResource HackerButton}" Width="60" Height="24" FontSize="11" HorizontalAlignment="Right" Click="Scan_Click"/>
                                    </DockPanel>
                                    <ListBox x:Name="SingleHostList" Background="#161B22" Foreground="#C9D1D9" BorderThickness="0" FontFamily="Consolas" FontSize="12" MouseDoubleClick="SingleHostList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0,0,0,6"/>
                                </DockPanel>
                            </Border>
                            <!-- 右侧：连接控制 -->
                            <Border Grid.Column="2" Background="#161B22" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="5" Padding="10">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="[ 连接控制 ]" Foreground="#00FF41" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock Text="状态:" Foreground="#6E7681" FontFamily="Consolas" FontSize="11"/>
                                        <TextBlock x:Name="SingleConnStatus" Text="未连接" Foreground="#FF6B6B" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="目标IP:" Foreground="#6E7681" FontFamily="Consolas" FontSize="11"/>
                                        <TextBox x:Name="SingleIpBox" Style="{StaticResource HackerInput}" Margin="0,2,0,6"/>
                                        <TextBlock Text="频道:" Foreground="#6E7681" FontFamily="Consolas" FontSize="11"/>
                                        <TextBox x:Name="SingleChannelBox" Text="1" Style="{StaticResource HackerInput}" Margin="0,2,0,6" Width="60"/>
                                        <Button x:Name="BtnSingleConnect" Content="[连接]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SingleConnect_Click"/>
                                        <Button x:Name="BtnSingleDisconnect" Content="[断开]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SingleDisconnect_Click" IsEnabled="False"/>
                                        <TextBlock Text="[ 单播操作 ]" Foreground="#00FF41" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,14,0,10"/>
                                        <Button x:Name="BtnSingleBlack" Content="[黑屏]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SingleBlack_Click" IsEnabled="False"/>
                                        <TextBox x:Name="SingleBlackText" Style="{StaticResource HackerInput}" Margin="0,3" MaxLength="30" ToolTip="黑屏显示文字(可选)"/>
                                        <Button x:Name="BtnSingleUnlock" Content="[解锁]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SingleUnlock_Click" IsEnabled="False"/>
                                        <Button x:Name="BtnSingleMsg" Content="[发消息]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SingleMsg_Click" IsEnabled="False"/>
                                        <Button x:Name="BtnSingleShutdown" Content="[关机]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SingleShutdown_Click" IsEnabled="False"/>
                                        <Button x:Name="BtnSingleReboot" Content="[重启]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SingleReboot_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ========== 第二区：指定IP攻击 ========== -->
                <TabItem Header="指定IP攻击" Style="{StaticResource HackerTab}">
                    <Border Background="#0D1117" BorderBrush="#00FF41" BorderThickness="1,0,1,1" CornerRadius="0,0,5,5" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左侧：设备列表 -->
                            <Border Grid.Column="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="8,6">
                                        <TextBlock Text="频道:" Foreground="#8B949E" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox x:Name="AttackChannelBox" Text="1" Width="35" Style="{StaticResource HackerInput}" Margin="5,0,15,0"/>
                                        <TextBlock Text="目标IP:" Foreground="#8B949E" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox x:Name="AttackIpBox" Width="110" Style="{StaticResource HackerInput}" Margin="5,0,10,0"/>
                                        <Button Content="[扫描]" Style="{StaticResource HackerButton}" Width="60" Height="24" FontSize="11" HorizontalAlignment="Right" Click="Scan_Click"/>
                                    </DockPanel>
                                    <ListBox x:Name="AttackHostList" Background="#161B22" Foreground="#C9D1D9" BorderThickness="0" FontFamily="Consolas" FontSize="12" MouseDoubleClick="HostList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0,0,0,6"/>
                                </DockPanel>
                            </Border>
                            <!-- 右侧：攻击面板 -->
                            <Border Grid.Column="2" Background="#161B22" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="5" Padding="10">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="[ 攻击面板 ]" Foreground="#FFD700" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <Button Content="[黑屏]" Style="{StaticResource HackerButton}" Margin="0,3" Click="Blackscreen_Click"/>
                                        <TextBox x:Name="BlackText" Style="{StaticResource HackerInput}" Margin="0,3" MaxLength="30" ToolTip="黑屏显示文字(可选)"/>
                                        <Button Content="[解锁]" Style="{StaticResource HackerButton}" Margin="0,3" Click="Unlock_Click"/>
                                        <Button Content="[发消息]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SendMsg_Click"/>
                                        <Button Content="[发命令]" Style="{StaticResource HackerButton}" Margin="0,3" Click="SendCmd_Click"/>
                                        <Button Content="[关机]" Style="{StaticResource HackerButton}" Margin="0,3" Click="Shutdown_Click"/>
                                        <Button Content="[重启]" Style="{StaticResource HackerButton}" Margin="0,3" Click="Reboot_Click"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ========== 第三区：屏幕监控 ========== -->
                <TabItem Header="屏幕监控" Style="{StaticResource HackerTab}">
                    <Border Background="#0D1117" BorderBrush="#00FF41" BorderThickness="1,0,1,1" CornerRadius="0,0,5,5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左侧：设备列表 + 远程控制 -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="[扫描设备]" Style="{StaticResource HackerButton}" Width="90" HorizontalAlignment="Left" Click="MonitorScan_Click"/>
                                <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Margin="0,8,0,8">
                                    <ListBox x:Name="MonitorSenderList" Background="#161B22" Foreground="#C9D1D9" BorderThickness="0" FontFamily="Consolas" FontSize="11" MouseDoubleClick="MonitorList_DoubleClick"/>
                                </Border>
                                <Border Grid.Row="2" Background="#161B22" BorderBrush="#00FF41" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="── 远程控制 ──" Foreground="#00FF41" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="3" Rows="4">
                                            <Button Content="[关机]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="0,0,3,3" Click="RemoteShutdown_Click"/>
                                            <Button Content="[重启]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="3,0,3,3" Click="RemoteReboot_Click"/>
                                            <Button Content="[命令]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="3,0,0,3" Click="RemoteCmd_Click"/>
                                            <Button Content="[观看]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="0,3,3,3" Click="RemoteWatch_Click"/>
                                            <Button Content="[CMD终端]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="3,3,3,3" Click="RemoteCmdTerminal_Click"/>
                                            <Button Content="[PS终端]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="3,3,0,3" Click="RemotePsTerminal_Click"/>
                                            <Button Content="[Win10恶搞]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="0,3,3,0" Click="RemoteOobeWin10_Click"/>
                                            <Button Content="[Win11恶搞]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="3,3,3,0" Click="RemoteOobeWin11_Click"/>
                                            <Button Content="[封禁]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="0,3,3,0" Foreground="#FF6B6B" Click="RemoteBan_Click"/>
                                            <Button Content="[进程管理]" Style="{StaticResource HackerButton}" Height="26" FontSize="10" Margin="3,3,3,0" Click="RemoteProcess_Click"/>
                                        </UniformGrid>
                                        <TextBlock Text="── 服务模式 ──" Foreground="#FFD700" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Margin="0,8,0,4"/>
                                        <UniformGrid Columns="2" Rows="2">
                                            <Button Content="[安装服务]" Style="{StaticResource HackerButton}" Height="24" FontSize="9" Margin="0,0,3,3" Click="RemoteInstallService_Click" ToolTip="以SYSTEM权限安装Windows服务,开机自启+被杀自动重启"/>
                                            <Button Content="[卸载服务]" Style="{StaticResource HackerButton}" Height="24" FontSize="9" Margin="3,0,0,3" Foreground="#FF6B6B" Click="RemoteUninstallService_Click"/>
                                            <Button Content="[重启普通模式]" Style="{StaticResource HackerButton}" Height="24" FontSize="9" Margin="0,3,3,0" Click="RemoteRestartNormal_Click" ToolTip="通过SYSTEM模式用CreateProcessAsUser重启普通模式(恢复屏幕监控)"/>
                                            <Button Content="" Style="{StaticResource HackerButton}" Height="24" FontSize="9" Margin="3,3,0,0" Visibility="Hidden"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- 右侧：视频画面 -->
                            <Border Grid.Column="2" Background="#000000" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4">
                                <Image x:Name="MonitorVideoImage" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- 日志区 -->
            <Border Grid.Row="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,10">
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#00FF41" BorderThickness="0" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Hidden" Height="75"/>
            </Border>
            <TextBlock Grid.Row="4" x:Name="StatusText" Text="Status: Ready" Foreground="#484F58" FontFamily="Consolas" FontSize="10"/>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
