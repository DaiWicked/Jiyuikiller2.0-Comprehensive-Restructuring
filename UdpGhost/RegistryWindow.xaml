<Window x:Class="UdpGhost.RegistryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程注册表" Height="400" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117" Foreground="#C9D1D9"
        FontFamily="Consolas" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="HackerButton" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C2128"/>
                    <Setter Property="BorderBrush" Value="#00FF41"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：路径输入 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="注册表路径 (格式: HKCU\路径|值名)" Foreground="#00FF41" FontSize="11" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="PathBox" Height="26" Width="420" Background="#161B22" Foreground="#C9D1D9" BorderBrush="#00FF41" BorderThickness="1" Padding="4" FontSize="11" Text="HKCU\Control Panel\Desktop|Wallpaper"/>
                <Button Content="[读取]" Width="60" Height="26" Click="BtnRead_Click" Style="{StaticResource HackerButton}" Margin="5,0,0,0"/>
                <Button Content="[删除]" Width="60" Height="26" Click="BtnDelete_Click" Style="{StaticResource HackerButton}" Foreground="#FF6B6B" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 中间：结果显示 -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
            <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#00FF41" BorderThickness="0" Padding="8" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- 底部：写入区 -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="写入 (类型: SZ/DWORD/QWORD/BINARY/EXPAND_SZ/MULTI_SZ)" Foreground="#FFD700" FontSize="10" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox x:Name="WriteTypeBox" Height="24" Width="80" Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" Padding="4" FontSize="10" Text="SZ"/>
                <TextBlock Text="数据:" VerticalAlignment="Center" Foreground="#8B949E" Margin="8,0,4,0" FontSize="10"/>
                <TextBox x:Name="WriteDataBox" Height="24" Width="380" Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" Padding="4" FontSize="10"/>
                <Button Content="[写入]" Width="60" Height="24" Click="BtnWrite_Click" Style="{StaticResource HackerButton}" Margin="5,0,0,0"/>
            </StackPanel>
            <TextBlock Text="提示: DWORD输入数字, SZ输入字符串, BINARY输入Base64, MULTI_SZ用\n分隔" Foreground="#6E7681" FontSize="9"/>
        </StackPanel>
    </Grid>
</Window>
