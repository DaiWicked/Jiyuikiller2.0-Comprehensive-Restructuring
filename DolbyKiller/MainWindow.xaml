<Window x:Class="DolbyKiller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:DolbyKiller.Effects"
        Title="反制工具 DolbyKiller"
        Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/DolbyKiller;component/Assets/DolbyKiller.ico"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 状态图标颜色绑定 -->
        <SolidColorBrush x:Key="StatusIconColor" Color="#FFB0B0B0" />
    </Window.Resources>

    <!-- 窗口根容器 -->
    <Grid Background="Transparent">
        <!-- 外层玻璃容器（对角渐变边框） -->
        <Border x:Name="GlassContainer" CornerRadius="16" Margin="0" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#C0FFFFFF" Offset="0" />
                    <GradientStop Color="#80FFFFFF" Offset="0.3" />
                    <GradientStop Color="#40A8D0F0" Offset="0.7" />
                    <GradientStop Color="#2080B0D0" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <!-- 圆角裁剪根 -->
            <Grid x:Name="GlassClipRoot" ClipToBounds="True">
                <!-- 层1：深色渐变背景（代替液态玻璃，Win7兼容） -->
                <Border x:Name="BackgroundLayer" CornerRadius="16" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0F0F1A" Offset="0" />
                            <GradientStop Color="#FF1A1A2E" Offset="0.5" />
                            <GradientStop Color="#FF16213E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 层2：极光色相循环层 -->
                <Border CornerRadius="16" ClipToBounds="True" IsHitTestVisible="False">
                    <effects:AuroraLayer x:Name="AuroraLayer" />
                </Border>

                <!-- 层3：顶部光感层 -->
                <Border x:Name="GlowLayer" CornerRadius="16" ClipToBounds="True" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.1" RadiusX="0.8" RadiusY="0.6" GradientOrigin="0.5,0.1">
                            <GradientStop Color="#30FFFFFF" Offset="0" />
                            <GradientStop Color="#10FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 层4：内容层 -->
                <Border x:Name="ContentLayer" Background="Transparent" CornerRadius="16" ClipToBounds="True">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ===== 标题栏 ===== -->
                        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShield}" Width="16" Height="16" Fill="#FFE85D3A" Stretch="Uniform" />
                                <TextBlock Text="反制工具" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFE8E8E8" Margin="6,0,0,0" />
                                <TextBlock Text="DolbyKiller v1.0" FontSize="11" VerticalAlignment="Center" Foreground="#FF909090" Margin="8,0,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BtnClose" Content="✕" Width="32" Height="28"
                                    Click="BtnClose_Click" Style="{StaticResource GlassButtonSecondary}"
                                    Padding="0" FontSize="14" FontWeight="Bold"
                                    Background="Transparent" Foreground="#FFE0E0E0" BorderBrush="Transparent" />
                        </Grid>

                        <!-- ===== 状态卡片 ===== -->
                        <Border Grid.Row="1" Margin="16,8,16,8" Padding="16,14"
                                Background="{StaticResource GlassCardBrush}"
                                BorderBrush="{StaticResource GlassCardBorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 状态大图标 -->
                                <Viewbox Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="StatusIcon" Data="{StaticResource IconShield}"
                                          Fill="{StaticResource StatusIconColor}" Stretch="Uniform" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusTitle" Text="等待扫描"
                                               FontSize="18" FontWeight="Bold" Foreground="#FFE8E8E8" />
                                    <TextBlock x:Name="StatusSubtitle" Text="点击下方按钮开始检测您的电脑"
                                               FontSize="12" Foreground="#FFA0A0A0" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== 结果列表 ===== -->
                        <ListBox Grid.Row="2" x:Name="ResultItemsControl" Margin="16,0,16,0"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemRoot" Style="{StaticResource ThreatItemContainer}" Opacity="0" Loaded="ThreatItem_Loaded">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="10" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 威胁图标 -->
                                                <Ellipse Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FFF39C12" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                                                    <Setter Property="Fill" Value="#FFE74C3C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                    <Setter Property="Fill" Value="#FF3498DB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="!" FontSize="13" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                <!-- 威胁信息 -->
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFE8E8E8" />
                                                        <Border Background="#25FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#FFA0A0A0" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FF909090" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        <!-- ===== 操作按钮 ===== -->
                        <Grid Grid.Row="3" Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnScan" Content="开始扫描"
                                    Click="BtnScan_Click" Style="{StaticResource GlassButtonSecondary}" />
                            <Button Grid.Column="2" x:Name="BtnClean" Content="一键清除"
                                    Click="BtnClean_Click" Style="{StaticResource GlassButton}"
                                    IsEnabled="False" />
                        </Grid>

                        <!-- ===== 日志区（可折叠） ===== -->
                        <Grid Grid.Row="4" Margin="16,0,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 日志标题栏（点击折叠） -->
                            <Grid Grid.Row="0" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="LogHeader_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="操作日志" FontSize="12" FontWeight="SemiBold" Foreground="#FFA0A0A0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="LogArrow" Text="▼" FontSize="10" Foreground="#FF909090" VerticalAlignment="Center" />
                            </Grid>
                            <!-- 日志内容 -->
                            <Border Grid.Row="1" x:Name="LogBorder" Margin="0,6,0,0"
                                    Background="#18FFFFFF" CornerRadius="8" Padding="10,8"
                                    MaxHeight="120">
                                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <ListBox x:Name="LogItemsControl" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="LogBd" Background="Transparent" Opacity="0">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="LogBd"
                                                                                Storyboard.TargetProperty="Opacity"
                                                                                From="0" To="1" Duration="0:0:0.2" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#FFB0B0B0"
                                                           TextWrapping="Wrap" Margin="0,0,0,2" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
