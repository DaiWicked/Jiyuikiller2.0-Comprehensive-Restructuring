<Window x:Class="DolbyKiller.RestartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清除完成"
        Height="200" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Border CornerRadius="14" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#C0FFFFFF" Offset="0" />
                <GradientStop Color="#40A8D0F0" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1A1A2E" Offset="0" />
                <GradientStop Color="#FF16213E" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="清除完成" FontSize="18" FontWeight="Bold"
                       Foreground="#FFE8E8E8" HorizontalAlignment="Center" />

            <!-- 提示文字 -->
            <TextBlock Grid.Row="1" Text="威胁已全部清除。&#10;是否立即重启电脑以确保完全生效？"
                       FontSize="13" Foreground="#FFA0A0A0" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="0,12" />

            <!-- 按钮：左是，右取消 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="是" x:Name="BtnYes"
                        Click="BtnYes_Click" Height="36"
                        FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FFE85D3A" BorderBrush="#80FF7B5C" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" Content="取消" x:Name="BtnCancel"
                        Click="BtnCancel_Click" Height="36"
                        FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#25FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
