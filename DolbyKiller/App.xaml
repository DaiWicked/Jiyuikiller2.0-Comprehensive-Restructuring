<Application x:Class="DolbyKiller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ========== 颜色变量 ========== -->
            <Color x:Key="PrimaryColor">#FFE85D3A</Color>
            <Color x:Key="PrimaryColorLight">#FFFF7B5C</Color>
            <Color x:Key="PrimaryColorDark">#FFC94A2E</Color>
            <Color x:Key="SuccessColor">#FF2ECC71</Color>
            <Color x:Key="WarningColor">#FFF39C12</Color>
            <Color x:Key="DangerColor">#FFE74C3C</Color>
            <Color x:Key="TextColor">#FFE8E8E8</Color>
            <Color x:Key="TextSubColor">#FFA0A0A0</Color>

            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryColorLight}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSubColor}" />

            <!-- ========== 卡片画刷（深色半透明） ========== -->
            <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#33FFFFFF" Offset="0" />
                <GradientStop Color="#18FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#40FFFFFF" />

            <!-- ========== 状态图标 Path 几何 ========== -->
            <!-- 盾牌 -->
            <PathGeometry x:Key="IconShield" Figures="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6l-9-4z" />
            <!-- 警告三角 -->
            <PathGeometry x:Key="IconWarning" Figures="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
            <!-- 对勾圆 -->
            <PathGeometry x:Key="IconCheck" Figures="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            <!-- 扫描/放大镜 -->
            <PathGeometry x:Key="IconScan" Figures="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
            <!-- 清除/垃圾桶 -->
            <PathGeometry x:Key="IconClean" Figures="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />

            <!-- ========== 玻璃按钮样式（橙红主色，COUI 风格：悬停上移+按压缩放回弹） ========== -->
            <Style x:Key="GlassButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#80FF7B5C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="btnRoot" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="btnTranslate" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="stateLayer" CornerRadius="10" Background="#00000000" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.1" />
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#14000000" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00000000" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.1" />
                                                <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.1" />
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1F000000" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.02">
                                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0">
                                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.02">
                                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0">
                                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#14000000" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#FFB0B0B0" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF808080" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== 次要按钮（深色半透明背景） ========== -->
            <Style x:Key="GlassButtonSecondary" TargetType="Button" BasedOn="{StaticResource GlassButton}">
                <Setter Property="Background" Value="#25FFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
            </Style>

            <!-- ========== 玻璃文本框 ========== -->
            <Style x:Key="GlassTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#A6FFFFFF" />
                <Setter Property="BorderBrush" Value="#1F000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>

            <!-- ========== 列表项容器（深色半透明） ========== -->
            <Style x:Key="ThreatItemContainer" TargetType="Border">
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
