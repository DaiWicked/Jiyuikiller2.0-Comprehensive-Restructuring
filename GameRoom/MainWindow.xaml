<Window x:Class="GameRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:eff="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="GameRoom" Height="540" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 霓虹主色按钮 -->
        <Style x:Key="NeonBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#FF6C5CE7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glow" CornerRadius="8" Background="#406C5CE7" Opacity="0" Margin="2">
                            </Border>
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="14,7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="hover" CornerRadius="8" Background="#33FFFFFF" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 幽灵按钮 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="hover" CornerRadius="6" Background="#1AFFFFFF" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玩家列表项样式 -->
        <Style x:Key="UserItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFEEEEEE" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#156C5CE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层：渐变背景 + 圆角 + 霓虹边框 -->
    <Border CornerRadius="14" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6C5CE7" Offset="0"/>
                <GradientStop Color="#FF00CEC8" Offset="0.5"/>
                <GradientStop Color="#FF6C5CE7" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF12121F" Offset="0"/>
                <GradientStop Color="#FF0D0D17" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="#00000000" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <!-- 小霓虹方块装饰 -->
                    <Border Width="10" Height="10" CornerRadius="2" Background="#FF6C5CE7" Margin="0,0,10,0"/>
                    <TextBlock Text="GameRoom" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleNick" Text="" FontSize="11" Foreground="#FF8888AA" VerticalAlignment="Center" Margin="10,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="—" Style="{StaticResource GhostBtn}" Click="MinBtn_Click" Width="34" Height="30" FontSize="14"/>
                    <Button Content="✕" Style="{StaticResource GhostBtn}" Click="CloseBtn_Click" Width="34" Height="30" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- 主区域 -->
            <Grid Grid.Row="1" Margin="14,4,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 在线玩家面板 -->
                <Border Grid.Column="0" CornerRadius="10" Background="#18FFFFFF" BorderBrush="#256C5CE7" BorderThickness="1" Margin="0,0,10,0">
                    <DockPanel Margin="12">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="在线玩家" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                            <Border Background="#306C5CE7" CornerRadius="8" Padding="6,1" Margin="10,0,0,0">
                                <TextBlock x:Name="UserCount" Text="0" FontSize="11" Foreground="#FF6C5CE7" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <ListBox x:Name="UserList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource UserItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>

                <!-- 游戏大厅 -->
                <Border Grid.Column="1" CornerRadius="10" Background="#18FFFFFF" BorderBrush="#256C5CE7" BorderThickness="1">
                    <DockPanel Margin="16">
                        <TextBlock DockPanel.Dock="Top" Text="🎮 游戏大厅" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,12"/>

                        <!-- 游戏卡片占位 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- 发光游戏图标 -->
                            <Border Width="80" Height="80" CornerRadius="16" Background="#206C5CE7" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <eff:DropShadowEffect Color="#FF6C5CE7" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <TextBlock Text="🎮" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="游戏开发中" FontSize="17" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="连接的玩家可以在此处开始对战" FontSize="12" Foreground="#FF8888AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" Background="#12000000" CornerRadius="0,0,13,13" Padding="16,6">
                <DockPanel>
                    <Ellipse Width="8" Height="8" Fill="#FF2ECC71" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogText" Text="就绪" FontSize="11" Foreground="#FF8888AA" VerticalAlignment="Center"/>
                    <Button Content="退出" Style="{StaticResource GhostBtn}" Click="CloseBtn_Click" DockPanel.Dock="Right" Padding="8,3" Margin="6,0,0,0"/>
                    <Button Content="刷新" Style="{StaticResource GhostBtn}" Click="Refresh_Click" DockPanel.Dock="Right" Padding="8,3"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
