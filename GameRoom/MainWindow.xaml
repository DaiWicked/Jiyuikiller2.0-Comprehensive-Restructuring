<Window x:Class="GameRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameRoom - 联机小游戏" Height="500" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#FF1a1a2e">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🎮 GameRoom" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleStatus" Text="  正在连接..." FontSize="12" Foreground="#FF888899" VerticalAlignment="Center" Margin="10,4,0,0"/>
        </StackPanel>

        <!-- 主区域：左=玩家列表 右=游戏区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 在线玩家 -->
            <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="在线玩家" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,8"/>
                    <ListBox x:Name="UserList" Background="Transparent" Foreground="#FFFFFFFF" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </Border>

            <!-- 游戏大厅（占位） -->
            <Border Grid.Column="1" Background="#15FFFFFF" CornerRadius="8" Padding="16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="游戏大厅" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="（游戏内容开发中...）" FontSize="12" Foreground="#FF888899" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="已连接玩家可在此处选择游戏" FontSize="11" Foreground="#FF666680" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="LogText" Text="就绪" FontSize="11" Foreground="#FF666680" VerticalAlignment="Center"/>
            <Button Content="刷新" Click="Refresh_Click" Width="60" Height="26" Margin="12,0,0,0" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
