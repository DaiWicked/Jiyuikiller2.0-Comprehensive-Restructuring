<Window x:Class="GameRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:eff="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="GameRoom" Icon="pack://application:,,,/GameRoom;component/Assets/game.ico" Height="560" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 幽灵按钮 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB9B3D6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="hover" CornerRadius="6" Background="#1AFFFFFF" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玩家列表项 -->
        <Style x:Key="UserItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#156C5CE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层圆角 -->
    <Border CornerRadius="14" BorderBrush="#FF2E2A4A" BorderThickness="1">
        <Grid>
            <!-- ① 背景层：渐变 + 柔光球 -->
            <Grid x:Name="BackdropHost">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0B0A14" Offset="0"/>
                            <GradientStop Color="#FF1A1430" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-140,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#556C5CE7" Offset="0"/>
                            <GradientStop Color="#006C5CE7" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-120">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#445B8DEF" Offset="0"/>
                            <GradientStop Color="#005B8DEF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- ② 磨砂层 -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <VisualBrush Visual="{Binding ElementName=BackdropHost}" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
                </Border.Background>
                <Border.Effect>
                    <eff:BlurEffect Radius="26" KernelType="Gaussian" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

            <!-- ③ 内容层 -->
            <Grid Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border Width="10" Height="10" CornerRadius="2" Background="#FF6C5CE7" Margin="0,0,10,0"/>
                        <TextBlock Text="GameRoom" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleNick" Text="" FontSize="11" Foreground="#FFB9B3D6" VerticalAlignment="Center" Margin="10,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="—" Style="{StaticResource GhostBtn}" Click="MinBtn_Click" Width="34" Height="30" FontSize="14"/>
                        <Button Content="✕" Style="{StaticResource GhostBtn}" Click="CloseBtn_Click" Width="34" Height="30" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- 主区域 -->
                <Grid Grid.Row="1" Margin="14,4,14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 在线玩家面板 -->
                    <Border Grid.Column="0" CornerRadius="12" Margin="0,0,10,0">
                        <Grid>
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <VisualBrush Visual="{Binding ElementName=BackdropHost}" Stretch="Fill"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                        <TranslateTransform X="-8" Y="-8"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <eff:BlurEffect Radius="18" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="#1AFFFFFF" CornerRadius="12"/>
                            <Border BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="12"/>
                            <DockPanel Margin="12">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="在线玩家" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                                    <Border Background="#306C5CE7" CornerRadius="8" Padding="6,1" Margin="10,0,0,0">
                                        <TextBlock x:Name="UserCount" Text="0" FontSize="11" Foreground="#FF8B7BF0" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <ListBox x:Name="UserList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource UserItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 游戏大厅 -->
                    <Border Grid.Column="1" CornerRadius="12">
                        <Grid>
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <VisualBrush Visual="{Binding ElementName=BackdropHost}" Stretch="Fill"/>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                        <TranslateTransform X="-8" Y="-8"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <eff:BlurEffect Radius="18" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="#1AFFFFFF" CornerRadius="12"/>
                            <Border BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="12"/>
                            <DockPanel Margin="16">
                                <TextBlock DockPanel.Dock="Top" Text="🎮 游戏大厅" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,12"/>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="16" Background="#206C5CE7" HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <eff:DropShadowEffect Color="#FF6C5CE7" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                        </Border.Effect>
                                        <TextBlock Text="🎮" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="游戏开发中" FontSize="17" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                    <TextBlock Text="连接的玩家可以在此处创建/加入房间" FontSize="12" Foreground="#FFB9B3D6" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 底部状态栏 -->
                <Border Grid.Row="2" Background="#12000000" CornerRadius="0,0,13,13" Padding="16,6">
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Fill="#FF2ECC71" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LogText" Text="就绪" FontSize="11" Foreground="#FFB9B3D6" VerticalAlignment="Center"/>
                        <Button Content="退出" Style="{StaticResource GhostBtn}" Click="CloseBtn_Click" DockPanel.Dock="Right" Padding="8,3" Margin="6,0,0,0"/>
                        <Button Content="刷新" Style="{StaticResource GhostBtn}" Click="Refresh_Click" DockPanel.Dock="Right" Padding="8,3"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
