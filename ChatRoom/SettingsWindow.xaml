<Window x:Class="ChatRoom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天设置" Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F5" ResizeMode="NoResize">
    <StackPanel Margin="20,16">
        <TextBlock Text="聊天设置" FontSize="18" FontWeight="Bold" Foreground="#1a1a2e" Margin="0,0,0,16"/>

        <!-- 昵称 -->
        <TextBlock Text="昵称" FontSize="13" FontWeight="SemiBold" Foreground="#3a3a3c" Margin="0,0,0,4"/>
        <TextBox x:Name="InputNickname" Height="32" VerticalContentAlignment="Center" FontSize="13" Padding="8,0"/>

        <!-- 发送键 -->
        <TextBlock Text="发送键" FontSize="13" FontWeight="SemiBold" Foreground="#3a3a3c" Margin="0,12,0,4"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RadioEnter" Content="Enter 发送" IsChecked="True" Margin="0,0,20,0" FontSize="13"/>
            <RadioButton x:Name="RadioCtrlEnter" Content="Ctrl+Enter 发送" FontSize="13"/>
        </StackPanel>

        <!-- 字号 -->
        <TextBlock Text="消息字号" FontSize="13" FontWeight="SemiBold" Foreground="#3a3a3c" Margin="0,12,0,4"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RadioSmall" Content="小" Margin="0,0,16,0" FontSize="13"/>
            <RadioButton x:Name="RadioMedium" Content="中" IsChecked="True" Margin="0,0,16,0" FontSize="13"/>
            <RadioButton x:Name="RadioLarge" Content="大" FontSize="13"/>
        </StackPanel>

        <!-- 开关项 -->
        <CheckBox x:Name="CheckTopMost" Content="聊天窗口始终置顶" FontSize="13" Margin="0,12,0,0"/>
        <CheckBox x:Name="CheckClearOnExit" Content="关闭时清空聊天记录" FontSize="13" Margin="0,8,0,0"/>

        <!-- 关于 / 使用教程 -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="使用教程" Width="90" Height="30" Margin="0,0,8,0" Click="BtnHelp_Click"
                    Background="#EFEFF4" BorderThickness="0" Cursor="Hand"/>
            <Button Content="关于" Width="70" Height="30" Click="BtnAbout_Click"
                    Background="#EFEFF4" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="70" Height="32" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="保存" Width="70" Height="32" Background="#4A90D9" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
