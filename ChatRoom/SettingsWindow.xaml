<Window x:Class="ChatRoom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatRoom"
        Title="聊天设置" Height="580" Width="410"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="NoResize" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- 玻璃拟态（豆包 Q2）：85% 不透明 + 1px 主色 20% 微光边框 + 圆角 12。
         全部控件改用主题资源 ⇒ 自动跟随明暗（原来颜色是硬编码的，切暗色后一片惨白）。 -->
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 胶囊单选（自绘，替掉系统方角灰底） -->
        <Style x:Key="SettingsRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="ring" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"/>
                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource Accent}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 勾选框（自绘圆角方块 + ✓） -->
        <Style x:Key="SettingsCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="5"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1.2">
                                <TextBlock x:Name="tick" Text="✓" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource GhostHover}"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GhostPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{DynamicResource Accent}" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource GlassPanel}"
            BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <!-- 顶栏：标题 + 关闭（也可拖动） -->
            <Border VerticalAlignment="Top" Height="46" Background="Transparent">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Click="BtnCancel_Click" Width="42"
                            Style="{StaticResource GhostBtn}" Margin="0,7,7,0"/>
                    <TextBlock Text="聊天设置" FontSize="15" FontWeight="SemiBold" Margin="18,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="18,56,18,18">
                <TextBlock Text="昵称" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="InputNickname" Style="{StaticResource SettingsTextBox}"/>

                <TextBlock Text="发送键" Style="{StaticResource SectionTitle}" Margin="2,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioEnter" Content="Enter 发送" IsChecked="True"
                                 Style="{StaticResource SettingsRadio}"/>
                    <RadioButton x:Name="RadioCtrlEnter" Content="Ctrl+Enter 发送"
                                 Style="{StaticResource SettingsRadio}"/>
                </StackPanel>

                <TextBlock Text="消息字号" Style="{StaticResource SectionTitle}" Margin="2,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioSmall" Content="小" Style="{StaticResource SettingsRadio}"/>
                    <RadioButton x:Name="RadioMedium" Content="中" IsChecked="True" Style="{StaticResource SettingsRadio}"/>
                    <RadioButton x:Name="RadioLarge" Content="大" Style="{StaticResource SettingsRadio}"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16,0,14"/>

                <CheckBox x:Name="CheckTopMost" Content="聊天窗口始终置顶" Style="{StaticResource SettingsCheck}"/>
                <CheckBox x:Name="CheckClearOnExit" Content="关闭时清空聊天记录"
                          Style="{StaticResource SettingsCheck}" Margin="0,12,0,0"/>
                <CheckBox x:Name="CheckToast" Content="收到新消息时弹窗提醒（后台/最小化也弹）"
                          Style="{StaticResource SettingsCheck}" Margin="0,12,0,0"/>
                <CheckBox x:Name="CheckAnim" Content="界面动效（淡入、滑动、呼吸光）"
                          Style="{StaticResource SettingsCheck}" Margin="0,12,0,0"/>

                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16,0,14"/>

                <TextBlock Text="聊天区壁纸" Style="{StaticResource SectionTitle}" Margin="2,16,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="选择图片" Click="BtnPickWallpaper_Click" Style="{StaticResource GhostBtn}"/>
                    <Button Content="清除" Click="BtnClearWallpaper_Click" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"/>
                    <TextBlock x:Name="TextWallpaper" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondary}" Text="未设置"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <TextBlock Text="透明度" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Slider x:Name="SliderWallpaper" Minimum="0" Maximum="1" Value="0.35" Width="180"
                            Margin="10,0,0,0" VerticalAlignment="Center" IsSnapToTickEnabled="True"
                            TickFrequency="0.05" ValueChanged="SliderWallpaper_ValueChanged"
                            Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="TextWallpaperOpacity" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondary}" Text="35%"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="使用教程" Click="BtnHelp_Click" Style="{StaticResource GhostBtn}"
                            Margin="0,0,8,0"/>
                    <Button Content="关于" Click="BtnAbout_Click" Style="{StaticResource GhostBtn}"/>
                    <Button Content="重置昵称" Click="BtnResetNick_Click" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 页脚：左侧版本号 + 右侧按钮，用 Grid 两列。
                     ★ 版本号不能单独占一行：整个内容是纵向 StackPanel，多一行会把页脚整体顶出窗口
                       （实测「取消/保存」被裁到窗口外）。
                     ★ 也不能把 HorizontalAlignment="Right" 放进横向 StackPanel（那是无效的，
                       文字会紧贴"重置昵称"冲出窗口右边被裁）。 -->
                <Grid Margin="0,18,0,0">
                    <TextBlock Text="{x:Static local:AppInfo.Version}" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Click="BtnCancel_Click" Style="{StaticResource GhostBtn}"
                                Width="76" Margin="0,0,8,0"/>
                        <Button Content="保存" Click="BtnSave_Click" Style="{StaticResource AccentBtn}" Width="88"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>