<Window x:Class="ChatRoom.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息提醒" Height="78" Width="292"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" MouseLeftButtonUp="Toast_Click">
    <!-- 独立提醒窗（后台/托盘时用）：
         ShowActivated=False 不抢焦点；ShowInTaskbar=False 不闪任务栏；全程无声音。
         玻璃拟态与主窗一致。 -->
    <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource ComposerBg}"
            BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" Opacity="0"
            Cursor="Hand">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#000000" />
        </Border.Effect>
        <Grid Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="30" Height="30" VerticalAlignment="Top">
                <Ellipse Fill="{DynamicResource Accent}" />
                <TextBlock Text="💬" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock x:Name="TextToastTitle" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TextToastText" FontSize="12" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>