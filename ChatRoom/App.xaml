<Application x:Class="ChatRoom.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="GlassBg" Color="#F0F0F5" Opacity="0.92"/>
        <SolidColorBrush x:Key="GlassBgDark" Color="#2D2D3A" Opacity="0.85"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4A90D9"/>
        <SolidColorBrush x:Key="OnlineDot" Color="#4CD964"/>
        <SolidColorBrush x:Key="OfflineDot" Color="#8E8E93"/>
        <SolidColorBrush x:Key="MyBubbleBg" Color="#4A90D9"/>
        <SolidColorBrush x:Key="OtherBubbleBg" Color="#E8E8ED"/>
    </Application.Resources>
</Application>
