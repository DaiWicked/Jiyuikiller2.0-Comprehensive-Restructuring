<Application x:Class="ChatRoom.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF"/>
        <SolidColorBrush x:Key="OnlineDot" Color="#4CD964"/>
        <SolidColorBrush x:Key="OfflineDot" Color="#8E8E93"/>
        <SolidColorBrush x:Key="MyBubbleBg" Color="#5B8DEF"/>
        <SolidColorBrush x:Key="OtherBubbleBg" Color="#FFFFFF" Opacity="0.75"/>
        <SolidColorBrush x:Key="SystemMsg" Color="#8E8E93"/>
        <SolidColorBrush x:Key="PrivateBubbleBg" Color="#FFD699"/>
    </Application.Resources>
</Application>
