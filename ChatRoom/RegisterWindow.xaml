<Window x:Class="ChatRoom.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎来到聊天室" Height="430" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="NoResize" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="RegTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- 首次注册页（豆包需求 #2）：玻璃拟态 + 版式照她的图：
         logo / 欢迎语 / 昵称 / 在下方输入 yes 以验证 / 进入聊天室 -->
    <Border CornerRadius="12" Background="{DynamicResource GlassPanel}"
            BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.24" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="30,26,30,24">
            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource Accent}" Opacity="0.18">
                    <Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="72" Height="72">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Assets/chat.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <TextBlock Text="欢迎来到聊天室" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                       Margin="0,16,0,0" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="第一次使用，先给自己起个名字吧" FontSize="12" HorizontalAlignment="Center"
                       Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"/>

            <TextBlock Text="你的昵称" FontSize="12" FontWeight="SemiBold" Margin="2,18,0,6"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="InputNickname" Style="{StaticResource RegTextBox}"/>

            <TextBlock Text="在下方输入 yes 以验证" FontSize="12" FontWeight="SemiBold" Margin="2,14,0,6"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="InputVerify" Style="{StaticResource RegTextBox}"/>

            <TextBlock x:Name="TextTip" FontSize="11" Margin="2,8,0,0"
                       Foreground="{DynamicResource TextSecondary}" Text="请输入昵称，并在验证框里输入 yes"/>

            <Button x:Name="BtnEnter" Content="进入聊天室" Height="36" Margin="0,16,0,0"
                    Click="BtnEnter_Click" IsEnabled="False" Style="{StaticResource RegButton}"/>
            <Button Content="退出" Height="30" Margin="0,8,0,0" Click="BtnQuit_Click"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
    </Border>

</Window>