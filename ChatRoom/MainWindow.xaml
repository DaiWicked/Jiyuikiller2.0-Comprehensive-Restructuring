<Window x:Class="ChatRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小小聊天" Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F5"
        BorderThickness="0">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：在线用户列表 -->
        <Border Grid.Column="0" Background="#E8E8ED" Margin="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10" Background="#D1D1D6">
                    <TextBlock Text="在线用户" FontSize="14" FontWeight="SemiBold" Foreground="#3A3A3C"/>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#D1D1D6">
                    <Button x:Name="BtnGroupChat" Content="📢 群聊广播" Click="BtnGroupChat_Click"
                            Background="#4A90D9" Foreground="White" BorderThickness="0"
                            Padding="10,6" Cursor="Hand" HorizontalAlignment="Stretch"/>
                </Border>
                <ListBox x:Name="UserList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="UserList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#8E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#4CD964"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Nickname}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding IP}" FontSize="11" Foreground="#8E8E93"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右栏：聊天区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#F5F5F7">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnSettings" Content="⚙" Click="BtnSettings_Click"
                            DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                            Width="40" FontSize="16" Cursor="Hand" ToolTip="设置"/>
                    <TextBlock x:Name="ChatTitle" Text="# 群聊" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0" Foreground="#3A3A3C"/>
                </DockPanel>
            </Border>

            <!-- 聊天记录 -->
            <ScrollViewer Grid.Row="1" x:Name="ChatScroll" Background="#FAFAFA" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatItems" Padding="12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgBrush}" CornerRadius="10" Padding="10,6"
                                    Margin="{Binding Margin}" HorizontalAlignment="{Binding Align}"
                                    MaxWidth="450">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="#8E8E93"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Message}" FontSize="{Binding FontSize}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 输入区 -->
            <Border Grid.Row="2" Background="#F5F5F7">
                <DockPanel LastChildFill="True" Margin="8,6">
                    <Button x:Name="BtnSend" Content="发送" Click="BtnSend_Click"
                            Background="#4A90D9" Foreground="White" BorderThickness="0"
                            Padding="16,0" Margin="8,0,0,0" Width="70" Cursor="Hand"/>
                    <TextBox x:Name="InputBox" FontSize="13" VerticalContentAlignment="Center"
                             KeyDown="InputBox_KeyDown" Padding="8,6"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
