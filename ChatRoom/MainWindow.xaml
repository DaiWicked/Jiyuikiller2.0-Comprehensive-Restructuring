<Window x:Class="ChatRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小小聊天" Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Border CornerRadius="12" Background="#F2F2F7" BorderBrush="#D1D1D6" BorderThickness="1">
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏 -->
            <Border Grid.Column="0" Background="#E8E8ED" CornerRadius="12,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12" Background="#D1D1D6" CornerRadius="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="在线用户" FontSize="14" FontWeight="SemiBold" Foreground="#3A3A3C"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock x:Name="UserCount" Text="(0)" FontSize="12" Foreground="#8E8E93"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="12,10" Background="#D1D1D6" CornerRadius="0,0,0,12">
                        <Button x:Name="BtnGroupChat" Content="📢 群聊广播" Click="BtnGroupChat_Click"
                                Background="#5B8DEF" Foreground="White" BorderThickness="0"
                                Padding="10,8" Cursor="Hand" HorizontalAlignment="Stretch" FontSize="13"/>
                    </Border>
                    <ListBox x:Name="UserList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="UserList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#8E8E93"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#4CD964"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Nickname}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding IP}" FontSize="11" Foreground="#8E8E93"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右栏 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="#F5F5F7" CornerRadius="0,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BtnExit" Content="✕" Click="BtnExit_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="44" FontSize="14" Cursor="Hand" ToolTip="退出"/>
                        <Button x:Name="BtnSettings" Content="⚙" Click="BtnSettings_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="44" FontSize="16" Cursor="Hand" ToolTip="设置"/>
                        <TextBlock x:Name="ChatTitle" Text="# 群聊" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="14,0" Foreground="#1C1C2E"/>
                    </DockPanel>
                </Border>

                <!-- 聊天记录 -->
                <ScrollViewer Grid.Row="1" x:Name="ChatScroll" Background="#FAFAFA" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChatItems" Padding="14,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BgBrush}" CornerRadius="12" Padding="12,7"
                                        Margin="{Binding Margin}" HorizontalAlignment="{Binding Align}"
                                        MaxWidth="480">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="#8E8E93"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Message}" FontSize="{Binding FontSize}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区 -->
                <Border Grid.Row="2" Background="#F5F5F7" CornerRadius="0,0,12,0">
                    <DockPanel LastChildFill="True" Margin="10,8">
                        <Button x:Name="BtnSend" Content="发送" Click="BtnSend_Click"
                                Background="#5B8DEF" Foreground="White" BorderThickness="0"
                                Padding="18,0" Margin="8,0,0,0" Width="72" Cursor="Hand" FontSize="13"/>
                        <Border Background="White" CornerRadius="8" BorderBrush="#D1D1D6" BorderThickness="1">
                            <TextBox x:Name="InputBox" FontSize="13" VerticalContentAlignment="Center"
                                     KeyDown="InputBox_KeyDown" Padding="10,8" BorderThickness="0"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
