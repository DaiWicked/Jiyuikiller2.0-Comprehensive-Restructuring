<Window x:Class="ChatRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小小聊天" Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Loaded="Extras_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- ============ 按钮样式（替代 WPF 默认模板：方角 + Aero 悬停 + 系统灰） ============ -->

        <!-- 主色按钮：发送 / 群聊广播。圆角 8、悬停变亮、按下变深 -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 动效参考 COUI：颜色/透明度用 animate*AsState，位移用 spring，缩放在 graphicsLayer。
                             这里用"叠加层透明度 + 缩放"实现：主题画刷从 Application.Resources 来（已冻结），
                             直接动画它的 Color 会抛异常，所以改成动画叠加层 Opacity。 -->
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="hoverLayer" CornerRadius="8" Background="#26FFFFFF" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="pressLayer" CornerRadius="8" Background="#33000000" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标按钮：☾ ⚙ ✕ 📎。平时无底色，悬停才浮出圆角底 + 文字变主色 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Margin="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="hoverLayer" CornerRadius="6" Margin="3" Background="#1F000000" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="pressLayer" CornerRadius="6" Margin="3" Background="#33000000" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：8px、圆角滑块、无箭头（原来那条是系统灰箭头，最显旧的地方之一） -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Margin="2,0"
                                                        Background="{DynamicResource ScrollThumb}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- ================= 窗口外壳（玻璃血统：圆角 + 细描边 + 投影 + 顶部高光） =================
         只是"外壳"语汇；内容层（消息区/气泡/输入框）一律实色 —— 聊天以可读性为先。
         尺寸取自官方 tdesktop 源码实测值：侧栏固定 240、顶栏 54、列表行高 62、
         气泡圆角 16 / 最大宽 430 / 内边距 11×8。 -->
    <Border CornerRadius="12" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= 左栏：在线用户 ================= -->
            <Border Grid.Column="0" Background="{DynamicResource SideBg}" CornerRadius="12,0,0,12">
                <DockPanel>

                    <!-- 侧栏标题（也是拖动区） -->
                    <Border DockPanel.Dock="Top" Height="54" Background="{DynamicResource HeaderBg}"
                            CornerRadius="12,0,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                            <TextBlock Text="💬" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="在线用户" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock x:Name="UserCount" Text="(0)" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 底部：群聊广播 -->
                    <Border DockPanel.Dock="Bottom" Padding="10" Background="{DynamicResource SideBg}">
                        <Button x:Name="BtnGroupChat" Content="📢 群聊广播" Click="BtnGroupChat_Click"
                                Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentFg}"
                                BorderThickness="0" Padding="10,9" Cursor="Hand" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Stretch" FontSize="13" />
                    </Border>

                    <!-- 用户列表：行高 62（tdesktop dialogsRowHeight） -->
                    <ListBox x:Name="UserList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="UserList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="62" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource RowHoverBg}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource RowSelectedBg}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 头像：昵称首字 + 由 IP 稳定派生的底色 -->
                                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding AvatarBrush}" />
                                        <TextBlock Text="{Binding Initial}" FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nickname}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding IP}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- 未读徽标（会话分离后用于提示"谁给我发了消息"） -->
                                    <Border Grid.Column="3" Background="{DynamicResource Accent}" CornerRadius="8"
                                            MinWidth="16" Height="16" Padding="4,0" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding UnreadVisibility}">
                                        <TextBlock Text="{Binding UnreadText}" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Grid.Column="4" Width="9" Height="9" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FFB0B0B6" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#FF4CD964" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                        <Setter Property="Fill" Value="#FF5B8DEF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ================= 右栏 ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <!-- 顶栏（54，可拖动） -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" CornerRadius="0,12,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BtnExit" Content="✕" Click="BtnExit_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="46" FontSize="14" Cursor="Hand" ToolTip="退出" Style="{StaticResource IconButton}"
                                Foreground="{DynamicResource TextSecondary}" />
                        <Button x:Name="BtnTheme" Content="☾" Click="BtnTheme_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="40" FontSize="14" Cursor="Hand" ToolTip="切换明暗主题" Style="{StaticResource IconButton}"
                                Foreground="{DynamicResource TextSecondary}" />
                        <Button x:Name="BtnSearch" Content="🔍" Click="BtnSearch_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="40" FontSize="14" Cursor="Hand" ToolTip="搜索聊天记录 (Ctrl+F)"
                                Foreground="{DynamicResource TextSecondary}" Style="{StaticResource IconButton}" />
                        <Button x:Name="BtnSettings" Content="⚙" Click="BtnSettings_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="46" FontSize="16" Cursor="Hand" ToolTip="设置" Style="{StaticResource IconButton}"
                                Foreground="{DynamicResource TextSecondary}" />
                        <!-- 未读徽标：窗口不在前台时收到消息才出现，点它=跳到最新并清零 -->
                        <Button x:Name="BtnUnread" Click="BtnUnread_Click" Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5"
                                DockPanel.Dock="Right" Padding="10,4" Margin="0,0,6,0"
                                FontSize="12" VerticalAlignment="Center" ToolTip="跳到最新消息"
                                Style="{StaticResource AccentButton}">
                            <TextBlock x:Name="TextUnread" Text="0 条新消息" />
                        </Button>
                        <TextBlock x:Name="ChatTitle" Text="# 群聊" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="14,0"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- 消息区：底色与白色来消息气泡刻意拉开（原来白气泡压在 #FAFAFA 上几乎看不见） -->
                <ScrollViewer Grid.Row="1" x:Name="ChatScroll" Background="{DynamicResource ChatBg}"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="ChatItems" Padding="14,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" Padding="11,8" MaxWidth="430"
                                        Margin="{Binding Margin}"
                                        HorizontalAlignment="{Binding Align}"
                                        Background="{Binding BgBrush}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1"
                                        Loaded="Bubble_Loaded">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制文字" Click="MsgMenu_Copy" />
                                            <MenuItem Header="引用回复" Click="MsgMenu_Quote" />
                                            <Separator />
                                            <MenuItem Header="删除本条（本地）" Click="MsgMenu_Delete" />
                                            <MenuItem Header="导出聊天记录…" Click="MsgMenu_Export" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}" FontSize="11"
                                                   Foreground="{Binding SecondaryBrush}"
                                                   Margin="0,0,0,2" />
                                        <!-- 图片消息：点一下用系统查看器打开 -->
                                        <Image Source="{Binding Image}" MaxWidth="200" MaxHeight="150"
                                               Margin="0,2" Stretch="Uniform" Cursor="Hand"
                                               MouseLeftButtonUp="Image_MouseLeftButtonUp">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- 文件消息（豆包 #6）：文件名 + 大小，点击另存为。
                                             可执行文件名走 WarnFg 红字。 -->
                                        <Border Margin="0,2" Padding="9,7" CornerRadius="9" Cursor="Hand"
                                                Background="{Binding FileCardBg}"
                                                BorderBrush="{Binding FileCardBorder}" BorderThickness="1"
                                                MouseLeftButtonUp="File_MouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄" FontSize="17" VerticalAlignment="Center"
                                                           Foreground="{Binding FileNameBrush}"/>
                                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"
                                                               MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding FileNameBrush}"/>
                                                    <TextBlock FontSize="10" Margin="0,2,0,0"
                                                               Foreground="{Binding SecondaryBrush}">
                                                        <Run Text="{Binding FileSizeText}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding FileHint}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="msgText" Text="{Binding Message}" FontSize="{Binding FontSize}"
                                                   Foreground="{Binding TextBrush}"
                                                   TextWrapping="Wrap">
                                            <!-- 文件气泡的正文就是"[文件] 名 (大小)"，与上面的卡片重复，隐藏掉 -->
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 时间戳（原实现只写进历史文件，气泡上没有） -->
                                        <TextBlock Text="{Binding Time}" FontSize="10"
                                                   Foreground="{Binding SecondaryBrush}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter TargetName="msgText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 内嵌消息弹窗（需求#5）：右下角浮动卡片，不抢焦点/不闪任务栏/无声音 -->
                <Border x:Name="ToastCard" Grid.Row="1" Visibility="Collapsed" Opacity="0"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"
                        Panel.ZIndex="9" Width="266" CornerRadius="12" Padding="12,10"
                        Background="{DynamicResource ComposerBg}" BorderBrush="#335B8DEF" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonUp="Toast_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="TextToastTitle" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TextToastText" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>                <!-- 搜索条：覆盖在消息区顶部（Ctrl+F / 点 🔍 出现）。
                     用叠加而不是新增一行 Grid 定义，避免动到已有布局。 -->
                <Border Grid.Row="1" x:Name="SearchBar" Visibility="Collapsed" VerticalAlignment="Top"
                        Panel.ZIndex="5" Margin="8" Padding="8,6" CornerRadius="10"
                        Background="{DynamicResource ComposerBg}" BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                    </Border.Effect>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BtnSearchClose" Content="✕" Click="BtnSearchClose_Click"
                                DockPanel.Dock="Right" Width="30" FontSize="12" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" ToolTip="关闭搜索"
                                Foreground="{DynamicResource TextSecondary}" Style="{StaticResource IconButton}" />
                        <TextBlock x:Name="TextSearchInfo" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Margin="8,0" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Text="输入关键词搜索聊天记录" />
                        <TextBox x:Name="SearchBox" FontSize="13" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="4,2"
                                 Foreground="{DynamicResource TextPrimary}"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                    </DockPanel>
                </Border>

                <!-- 输入区（56） -->
                <Border Grid.Row="2" Background="{DynamicResource ComposerBg}" CornerRadius="0,0,12,0">
                    <DockPanel LastChildFill="True" Margin="10,8">
                        <Button x:Name="BtnEmoji" Content="😀" Click="BtnEmoji_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="40" FontSize="16" Cursor="Hand" ToolTip="表情 (Ctrl+E)"
                                Foreground="{DynamicResource TextSecondary}" Style="{StaticResource IconButton}" />
                        <Button x:Name="BtnImage" Content="📎" Click="BtnImage_Click"
                                DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                Width="40" FontSize="16" Cursor="Hand" ToolTip="发送图片（jpg/png/bmp/gif）" Style="{StaticResource IconButton}"
                                Foreground="{DynamicResource TextSecondary}" />
                        <Button x:Name="BtnSend" Content="发送" Click="BtnSend_Click"
                                Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentFg}"
                                BorderThickness="0" Padding="18,0" Margin="8,0,0,0" Width="76" Style="{StaticResource AccentButton}"
                                Cursor="Hand" FontSize="13" />
                        <Border Background="{DynamicResource InputBg}" CornerRadius="10"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!-- 聚焦时描边变主色（原来一直是灰的，看不出焦点在哪） -->
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=InputBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox x:Name="InputBox" FontSize="13" VerticalContentAlignment="Center"
                                     KeyDown="InputBox_KeyDown" Padding="10,8" BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimary}" />
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- emoji 面板：本地 Unicode，点一下插到光标处；StaysOpen=False 点外面自动收起 -->
            <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=BtnEmoji}" Placement="Top"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Margin="0,0,0,6" Padding="6" CornerRadius="12"
                        Background="{DynamicResource ComposerBg}"
                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                    </Border.Effect>
                    <WrapPanel x:Name="EmojiPanel" Width="300" />
                </Border>
            </Popup>
            <!-- 顶部高光（玻璃语汇；纯视觉、不吃鼠标事件） -->
            <Border Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top" IsHitTestVisible="False"
                    CornerRadius="12,12,0,0" Opacity="0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#18FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Border>
</Window>
