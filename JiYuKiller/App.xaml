<Application x:Class="JiYuKiller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 鍏ㄥ眬 Liquid Glass 鏍峰紡 -->
        <ResourceDictionary>
            <!-- 棰滆壊鍙橀噺 -->
            <Color x:Key="GlassBgColor">#B8FFFFFF</Color>
            <Color x:Key="GlassBorderColor">#80FFFFFF</Color>
            <Color x:Key="GlassTextColor">#FF0A0A0A</Color>
            <Color x:Key="GlassPrimaryColor">#FF37B0FF</Color>
            <Color x:Key="GlassSuccessColor">#FF28A745</Color>
            <Color x:Key="GlassDangerColor">#FFFF6B6B</Color>

            <!-- COUI 5绾urface閰嶈壊锛堜粠婧愮爜鎻愬彇: F0F1F2->鐧?>鐧?>E6E6E6->鐧斤級 -->
            <Color x:Key="SurfaceLevel0Color">#FFF0F1F2</Color>
            <Color x:Key="SurfaceLevel1Color">#FFFFFFFF</Color>
            <Color x:Key="SurfaceLevel2Color">#FFFFFFFF</Color>
            <Color x:Key="SurfaceLevel3Color">#FFE6E6E6</Color>
            <Color x:Key="SurfaceLevel4Color">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="SurfaceLevel0Brush" Color="{StaticResource SurfaceLevel0Color}" />
            <SolidColorBrush x:Key="SurfaceLevel1Brush" Color="{StaticResource SurfaceLevel1Color}" />
            <SolidColorBrush x:Key="SurfaceLevel2Brush" Color="{StaticResource SurfaceLevel2Color}" />
            <SolidColorBrush x:Key="SurfaceLevel3Brush" Color="{StaticResource SurfaceLevel3Color}" />
            <SolidColorBrush x:Key="SurfaceLevel4Brush" Color="{StaticResource SurfaceLevel4Color}" />

            <!-- 鐜荤拑鑳屾櫙鐢诲埛 -->
            <SolidColorBrush x:Key="GlassBackgroundBrush" Color="{StaticResource GlassBgColor}" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}" />
            <SolidColorBrush x:Key="GlassTextBrush" Color="{StaticResource GlassTextColor}" />
            <SolidColorBrush x:Key="GlassPrimaryBrush" Color="{StaticResource GlassPrimaryColor}" />
            <SolidColorBrush x:Key="GlassSuccessBrush" Color="{StaticResource GlassSuccessColor}" />
            <SolidColorBrush x:Key="GlassDangerBrush" Color="{StaticResource GlassDangerColor}" />

            <!-- 鐜荤拑鎸夐挳鏍峰紡锛堝€熼壌COUI: Sink鎸夊帇缂╂斁 + 鐘舵€佸眰瑕嗙洊 + Storyboard鍔ㄧ敾锛?-->
            <!-- 娉ㄦ剰: 涓嶅姩鐢昏儗鏅壊, 鍙€氳繃鐘舵€佸眰鍙犲姞鏆楄壊, 淇濈暀鎸夐挳鍘熷鑳屾櫙鑹?-->
            <Style x:Key="GlassButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GlassPrimaryBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#8064BEFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="btnRoot">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="btnScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5" />
                                        <TranslateTransform x:Name="btnTranslate" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <!-- 涓昏儗鏅眰 -->
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- 鐘舵€佸眰锛圕OUI: 鎮仠8%榛? 鎸夊帇12%榛戯級 -->
                                <Border x:Name="stateLayer" CornerRadius="8" Background="#00000000" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 鎮仠: 涓婄Щ1px + 鐘舵€佸眰8%榛?-->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="-1" Duration="0:0:0.1" />
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#14000000" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="btnTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00000000" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <!-- 鎸夊帇: 缂╂斁0.92 + 鐘舵€佸眰12%榛?+ 鍥炲脊 -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.1" />
                                                <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.1" />
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1F000000" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.02" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.02" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <ColorAnimation Storyboard.TargetName="stateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#14000000" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 瀵艰埅鏍忔恫鎬佺幓鐠冩寜閽牱寮忥紙鍔ㄧ敾浣滅敤鍦ㄦ暣涓狦rid, 鏁翠綋缂╂斁, 涓嶅彈BlurEffect褰卞搷锛?-->
            <Style x:Key="NavGlassButton" TargetType="Button">
                <Setter Property="Foreground" Value="#FFF2F5F8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="navRoot">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="navScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5" />
                                        <TranslateTransform x:Name="navTranslate" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <!-- 楂樻柉妯＄硦鐜荤拑鑳屾櫙灞?-->
                                <Border x:Name="glassBg" Background="#28FFFFFF" CornerRadius="16">
                                    <Border.Effect>
                                        <BlurEffect Radius="6" />
                                    </Border.Effect>
                                </Border>
                                <!-- 杈圭紭楂樺厜 -->
                                <Border x:Name="glassBorder" CornerRadius="16" BorderThickness="1" BorderBrush="#40FFFFFF" IsHitTestVisible="False" />
                                <!-- 鐘舵€佸眰 -->
                                <Border x:Name="navStateLayer" CornerRadius="16" Background="#00000000" IsHitTestVisible="False" />
                                <!-- 鏂囧瓧灞?-->
                                <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 鎮仠 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="navTranslate" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.1" />
                                                <ColorAnimation Storyboard.TargetName="glassBg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#48FFFFFF" Duration="0:0:0.15" />
                                                <ColorAnimation Storyboard.TargetName="glassBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#70FFFFFF" Duration="0:0:0.15" />
                                                <ColorAnimation Storyboard.TargetName="navStateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0A000000" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="navTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                                <ColorAnimation Storyboard.TargetName="glassBg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#28FFFFFF" Duration="0:0:0.2" />
                                                <ColorAnimation Storyboard.TargetName="glassBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#40FFFFFF" Duration="0:0:0.2" />
                                                <ColorAnimation Storyboard.TargetName="navStateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00000000" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <!-- 鎸夊帇 -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.1" />
                                                <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.1" />
                                                <ColorAnimation Storyboard.TargetName="glassBg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#60FFFFFF" Duration="0:0:0.1" />
                                                <ColorAnimation Storyboard.TargetName="navStateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#14000000" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleX">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.02" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleY">
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.02" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <ColorAnimation Storyboard.TargetName="glassBg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#48FFFFFF" Duration="0:0:0.2" />
                                                <ColorAnimation Storyboard.TargetName="navStateLayer" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0A000000" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 閫忔槑RepeatButton鏍峰紡锛圫lider杞ㄩ亾鐐瑰嚮鐢紝涓嶆樉绀鸿瑙夛級 -->
            <Style x:Key="SliderRepeatButtonTransparent" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鐜荤拑婊戝潡鏍峰紡锛堝€熼壌COUI: Thumb鎮仠鏀惧ぇ1.1, 鎷栧姩鏀惧ぇ1.25, 甯﹂槾褰憋級 -->
            <Style x:Key="GlassSlider" TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource GlassPrimaryBrush}" />
                <Setter Property="Background" Value="#20000000" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <!-- 杞ㄩ亾鑳屾櫙 -->
                                <Border x:Name="TrackBackground" Height="4" CornerRadius="2" Background="#30000000" VerticalAlignment="Center" />
                                <!-- 宸插～鍏呴儴鍒?-->
                                <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0" />
                                <!-- Thumb -->
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderRepeatButtonTransparent}" Command="Slider.DecreaseLarge" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderRepeatButtonTransparent}" Command="Slider.IncreaseLarge" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18" Height="18">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <Ellipse x:Name="thumbEllipse" Fill="White" Stroke="{TemplateBinding Foreground}" StrokeThickness="2">
                                                            <Ellipse.RenderTransform>
                                                                <ScaleTransform x:Name="thumbScale" ScaleX="1" ScaleY="1" CenterX="9" CenterY="9" />
                                                            </Ellipse.RenderTransform>
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect Color="#40000000" BlurRadius="4" ShadowDepth="1" />
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1" />
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15" />
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX" To="1.25" Duration="0:0:0.1" />
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY" To="1.25" Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1" />
                                                                        <DoubleAnimation Storyboard.TargetName="thumbScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鐜荤拑寮€鍏虫牱寮忥紙鍊熼壌COUI Switch: 婊戝潡婊戝姩鍔ㄧ敾锛?-->
            <Style x:Key="GlassSwitch" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 寮€鍏宠建閬?-->
                                <Border x:Name="track" Width="44" Height="24" CornerRadius="12" Background="#40000000" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="knob" X="2" Y="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <!-- 寮€鍏虫粦鍧?-->
                                <Ellipse x:Name="knobCircle" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="knobTrans" X="0" Y="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#40000000" BlurRadius="3" ShadowDepth="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF37B0FF" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="knobTrans" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#40000000" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="knobTrans" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 鐜荤拑澶嶉€夋鏍峰紡 -->
            <Style x:Key="GlassCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- 鐜荤拑杈撳叆妗嗘牱寮?-->
            <Style x:Key="GlassTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#A6FFFFFF" />
                <Setter Property="BorderBrush" Value="#1F000000" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

