<UserControl x:Class="JiYuKiller.Games.GameMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="小游戏" FontSize="18" FontWeight="Bold" Foreground="#FF1a1a2e" VerticalAlignment="Center"/>
            <TextBlock Text="选一个开始摸鱼" FontSize="12" Foreground="#FF888899" VerticalAlignment="Center" Margin="10,3,0,0"/>
        </StackPanel>

        <!-- 游戏卡片 -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- 扫雷 -->
            <Border Width="190" Margin="8" Padding="16" CornerRadius="12" Background="#15000000"
                    Cursor="Hand" MouseLeftButtonDown="CardMinesweeper_Click">
                <StackPanel>
                    <!-- 图标改为矢量绘制: 原实现用的是 emoji 炸弹字符(码位 U+1F4A3),
                         Windows 7 的 Segoe UI Symbol 不含该码位, 会渲染成空心方框(tofu);
                         emoji 恐龙字符(U+1F996)更晚才有, Win8 与早期 Win10 同样缺失。
                         矢量图形不依赖系统字体。 -->
                    <Viewbox Width="42" Height="42" HorizontalAlignment="Center">
                        <Canvas Width="40" Height="40">
                            <Ellipse Canvas.Left="4" Canvas.Top="12" Width="28" Height="28" Fill="#FF2B2B2B" />
                            <Ellipse Canvas.Left="11" Canvas.Top="19" Width="7" Height="7" Fill="#66FFFFFF" />
                            <Path Stroke="#FF2B2B2B" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 28,12 L 33,6" />
                            <Path Fill="#FFFF8B0D" Data="M 33,5 L 36,1 L 39,5 L 36,9 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="扫雷" FontSize="15" FontWeight="Bold" Foreground="#FF1a1a2e" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="9×9 网格，10 颗雷" FontSize="11" Foreground="#FF888899" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="左键挖雷 · 右键标旗" FontSize="11" Foreground="#FF888899" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Content="开始" Click="OpenMinesweeper_Click" Style="{StaticResource GlassButton}" Height="30" FontSize="13" Padding="0" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- 恐龙跳 -->
            <Border Width="190" Margin="8" Padding="16" CornerRadius="12" Background="#15000000"
                    Cursor="Hand" MouseLeftButtonDown="CardDino_Click">
                <StackPanel>
                    <!-- 同上: 原为 emoji 恐龙字符, 改为矢量恐龙 -->
                    <Viewbox Width="52" Height="42" HorizontalAlignment="Center">
                        <Canvas Width="46" Height="40">
                            <Rectangle Canvas.Left="4" Canvas.Top="14" Width="11" Height="6" RadiusX="2" RadiusY="2" Fill="#FF3E7B3E" />
                            <Rectangle Canvas.Left="12" Canvas.Top="13" Width="21" Height="15" RadiusX="3" RadiusY="3" Fill="#FF3E7B3E" />
                            <Rectangle Canvas.Left="28" Canvas.Top="5" Width="15" Height="13" RadiusX="3" RadiusY="3" Fill="#FF3E7B3E" />
                            <Ellipse Canvas.Left="37" Canvas.Top="8" Width="3.5" Height="3.5" Fill="#FFFFFFFF" />
                            <Rectangle Canvas.Left="14" Canvas.Top="27" Width="5" Height="10" Fill="#FF2F5F2F" />
                            <Rectangle Canvas.Left="25" Canvas.Top="27" Width="5" Height="10" Fill="#FF2F5F2F" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="恐龙跳" FontSize="15" FontWeight="Bold" Foreground="#FF1a1a2e" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="躲避仙人掌，越跑越快" FontSize="11" Foreground="#FF888899" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="空格/点击跳跃" FontSize="11" Foreground="#FF888899" HorizontalAlignment="Center"/>
                    <Button Content="开始" Click="OpenDino_Click" Style="{StaticResource GlassButton}" Height="30" FontSize="13" Padding="0" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

        </WrapPanel>
    </Grid>
</UserControl>
