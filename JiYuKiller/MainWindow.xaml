                    <!-- 调试命令 -->
                    <Border Grid.Row="1" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="调试命令" FontSize="13" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TextDebugCmd" Grid.Column="0" Style="{StaticResource GlassTextBox}" Height="28" FontSize="13" VerticalContentAlignment="Center" KeyDown="TextDebugCmd_KeyDown" ToolTip="输入 help 查看可用命令" />
                                <Button x:Name="BtnRunCmd" Grid.Column="1" Content="执行" Style="{StaticResource GlassButton}" Click="BtnRunCmd_Click" Background="#FF007BFF" Margin="6,0,0,0" Padding="14,5" FontSize="12" />
                            </Grid>
                            <TextBlock Text="输入 help 查看可用命令，按回车快速执行" FontSize="11" Foreground="#FF404040" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 日志显示 -->
                    <TextBox x:Name="DebugLogBox" Grid.Row="2"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#FF1E1E1E"
                             Foreground="#FFD4D4D4"
                             BorderBrush="#FF0A0A0A"
                             BorderThickness="1"
                             VerticalScrollBarVisibility="Hidden"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>

            </Grid>


            <!-- 底部悬浮导航栏（3层：投影 / 玻璃主体(弱折射) / 渐变描边） -->
            <Grid Grid.Row="2" Margin="10,0,10,20" HorizontalAlignment="Stretch" Height="66">
                <!-- 层1: 投影（调柔，避免圆角外侧黑色残余） -->
                <Border CornerRadius="24" Margin="0,3,0,0" Background="#01000000" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.18" Color="#1A1A22" />
                    </Border.Effect>
                </Border>
                <!-- 层2: 玻璃主体
                     描边与裁剪共用同一套"超椭圆"几何（由 C# 生成），这样拐角处完全对齐；
                     如果把描边留在 Border 上（圆角是正圆弧），超椭圆的裁剪会盖住弧线，
                     四角会出现"描边被吃掉"的接缝 —— 所以这里用 Path 描边 + Grid 裁剪。 -->
                <Grid>
                    <Path x:Name="NavBarFramePath" Fill="{x:Null}" StrokeThickness="1" IsHitTestVisible="False">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#B0FFFFFF" Offset="0" />
                                <GradientStop Color="#50FFFFFF" Offset="0.35" />
                                <GradientStop Color="#22FFFFFF" Offset="0.7" />
                                <GradientStop Color="#66A8C0D8" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <!-- 裁剪根：Clip 由 C# 按尺寸生成（超椭圆），比外层小 1px（描边宽度） -->
                    <!-- 鼠标事件只用于"指针跟随柔光"和"点击波纹"，不设置 e.Handled，不影响按钮点击 -->
                    <Grid x:Name="NavBarClipRoot" Margin="1" ClipToBounds="True"
                          MouseMove="NavBarClipRoot_MouseMove"
                          MouseEnter="NavBarClipRoot_MouseEnter"
                          MouseLeave="NavBarClipRoot_MouseLeave"
                          PreviewMouseLeftButtonDown="NavBarClipRoot_PreviewMouseLeftButtonDown">
                        <!-- 2a-1: 液态玻璃折射层（外层挂 NavBarLensEffect，内层做模糊）
                             嵌套的原因：WPF 的 Effect 只能挂一个，父元素挂 shader 时它的 Input
                             采样里正好包含"子元素已模糊"的结果，这样就不必在 ps_2_0 里自己写高斯核。
                             Margin=-24 是为了让采样范围超出底栏本身 —— 真正的边缘折射必须能采到
                             "玻璃形状之外"的背景像素，否则偏移只会夹边、看着很假。 -->
                        <Border x:Name="NavBarLens" Margin="-24" IsHitTestVisible="False">
                            <Border.Effect>
                                <effects:NavBarLensEffect x:Name="NavBarLensFx" />
                            </Border.Effect>
                            <!-- 2a-2: 背景（VisualBrush取主程序背景底栏区域 + BlurEffect） -->
                            <Border x:Name="NavBarGlass">
                                <Border.Background>
                                    <VisualBrush x:Name="NavBarGlassBrush"
                                                 Visual="{Binding ElementName=BackdropContainer}"
                                                 Stretch="Fill"
                                                 ViewboxUnits="Absolute"
                                                 Viewbox="0,0,1,1" />
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="5" KernelType="Gaussian" />
                                </Border.Effect>
                            </Border>
                        </Border>
                        <!-- 2b: 中性遮罩（替代原来的白色渐变；保证任何背景下文字可读） -->
                        <Border x:Name="NavBarScrim" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3AFFFFFF" Offset="0" />
                                    <GradientStop Color="#4D000000" Offset="0.45" />
                                    <GradientStop Color="#66000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- 2c: 顶部高光（玻璃质感，保持轻薄） -->
                        <Border CornerRadius="23,23,0,0" Height="16" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#5AFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- 2d: 液态动态层（指针跟随柔光 + 点击波纹）
                             Canvas 的子元素不参与布局；整层 IsHitTestVisible=False 不拦鼠标 -->
                        <Canvas x:Name="NavBarFxLayer" IsHitTestVisible="False">
                            <!-- 跟随指针的柔光团：位置由 C# 按鼠标坐标写入 TranslateTransform -->
                            <Border x:Name="NavBarSpecular" Width="130" Height="64" Opacity="0"
                                    Canvas.Left="-65" Canvas.Top="-32">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavBarSpecularTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                                <Border.Background>
                                    <!-- 略偏冷的白（与底栏菲涅尔冷色同源），落到暖色壁纸上不显脏 -->
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                                        <GradientStop Color="#3EEEF5FF" Offset="0" />
                                        <GradientStop Color="#14E9F1FF" Offset="0.35" />
                                        <GradientStop Color="#00E9F1FF" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                        </Canvas>
                        <!-- 2e: 导航内容（唯一参与命中测试的部分，原样保留） -->
                        <ScrollViewer x:Name="NavScrollViewer" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" Padding="2,4"
                                      PreviewMouseWheel="NavScrollViewer_PreviewMouseWheel">
                            <Grid x:Name="NavContentGrid" HorizontalAlignment="Left" Height="48">
                                <!-- 指示器：嵌套玻璃
                                     它采样"背景原图"(BackdropContainer) 而不是父容器的渲染输出 ——
                                     采样祖先会形成循环引用，指示器会照到自己。
                                     采样原图的效果其实更对：底栏是磨砂的，指示器是浮在上面的一层"清玻璃"，
                                     而且滑动时背后的内容保持不动，这才是玻璃该有的感觉。 -->
                                <Border x:Name="NavIndicator" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Height="44" CornerRadius="18" Width="60" IsHitTestVisible="False">
                                    <Grid>
                                        <!-- 玻璃体：采样背景（Viewbox 由 C# 按指示器当前位置更新） -->
                                        <Border x:Name="NavIndicatorGlass" Margin="1" CornerRadius="17">
                                            <Border.Background>
                                                <VisualBrush x:Name="NavIndicatorBrush"
                                                             Visual="{Binding ElementName=BackdropContainer}"
                                                             Stretch="Fill"
                                                             ViewboxUnits="Absolute"
                                                             Viewbox="0,0,1,1" />
                                            </Border.Background>
                                        </Border>
                                        <!-- 提亮遮罩：让指示器明显比底栏"高一层"（原来的渐变背景保留在这里） -->
                                        <Border Margin="1" CornerRadius="17" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="{Binding Source={StaticResource NavIndicatorBrushTop}, Path=Color}" />
                                                    <GradientStop Offset="1" Color="{Binding Source={StaticResource NavIndicatorBrushBottom}, Path=Color}" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7AFFFFFF" Offset="0" />
                                            <GradientStop Color="#2AFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.BorderThickness>1</Border.BorderThickness>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="NavIndicatorTransform" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel Orientation="Horizontal" x:Name="NavStackPanel">
                                    <Button x:Name="NavQuick" Content="快捷栏" Click="NavQuick_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="64" Height="44" />
                                    <Button x:Name="NavSetting" Content="控制台和设置" Click="NavSetting_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="88" Height="44" />
                                    <Button x:Name="NavCustom" Content="自定义设置" Click="NavCustom_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="76" Height="44" />
                                    <Button x:Name="NavUdpAttack" Content="UDP攻击" Click="NavUdpAttack_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="72" Height="44" />
                                    <Button x:Name="NavChat" Content="小小私聊" Click="NavChat_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="72" Height="44" />
                                    <Button x:Name="NavScreenshot" Content="虚假反监视" Click="NavScreenshot_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="72" Height="44" />
                                    <Button x:Name="NavTeacherSim" Content="教师模拟" Click="NavTeacherSim_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="72" Height="44" />
                                    <Button x:Name="NavGames" Content="小游戏" Click="NavGames_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="64" Height="44" />
                                    <Button x:Name="NavHelp" Content="帮助文档" Click="NavHelp_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="64" Height="44" />
                                    <Button x:Name="NavDebug" Content="调试" Click="NavDebug_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="52" Height="44" />
                                    <Button x:Name="NavAbout" Content="关于" Click="NavAbout_Click" Style="{StaticResource NavGlassButton}" Padding="14,8" Margin="3,0" MinWidth="52" Height="44" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
                </Grid>
            </Border>
            <!-- 层4: 光感效果（渐变边框 + 顶部高光，不响应鼠标事件） -->
            <Border CornerRadius="16" BorderThickness="1.5" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A0FFFFFF" Offset="0" />
                        <GradientStop Color="#50A6E1FF" Offset="0.35" />
                        <GradientStop Color="#50FFB3E1" Offset="0.65" />
                        <GradientStop Color="#A0FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <!-- 顶部高光 -->
            <Border CornerRadius="16,16,0,0" Height="40" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#60FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Border>

    <!-- 彩蛋视频窗口(毛玻璃效果) -->
    <Border x:Name="EggWindow" CornerRadius="16" Background="#C81A1A1A" Visibility="Collapsed" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Height="320" BorderBrush="#60FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#A0000000" BlurRadius="24" ShadowDepth="4" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <!-- 顶部高光层 -->
            <Border CornerRadius="16" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.25" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <!-- 标题栏 -->
                <Grid Grid.Row="0" Background="#30FFFFFF">
                    <TextBlock Text="你发现了彩蛋" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <!-- 视频区域(保持黑色不透明) -->
                <Border Grid.Row="1" Background="#FF000000">
                    <MediaElement x:Name="EggMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaFailed="EggMedia_MediaFailed" />
                </Border>
                <!-- 底部按钮 -->
                <Grid Grid.Row="2" Background="#18FFFFFF">
                    <Button Content="关闭" Click="EggClose_Click" Style="{StaticResource GlassButton}" Width="100" Height="30" FontSize="13" Background="#FFDC3545" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
