                                    <Button x:Name="BtnRealtimeChooseVideo" Content="选择视频" Click="BtnRealtimeChooseVideo_Click" Style="{StaticResource GlassButton}" Background="#FF9C27B0" Height="36" Grid.Column="1" Margin="4,0,0,0" />
