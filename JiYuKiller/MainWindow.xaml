                                    <TextBox x:Name="TextTeacherSimCommand" Background="#FF1A1A1A" Foreground="#FF00FF00" FontSize="12" FontFamily="Consolas" Padding="6,4" Height="30" BorderThickness="0" KeyDown="TextTeacherSimCommand_KeyDown" />
                                    <Button Grid.Column="1" Content="发送" Click="BtnTeacherSimSend_Click" Style="{StaticResource GlassButton}" Background="#FF28A745" Width="60" Height="30" Margin="6,0,0,0" FontSize="12" />
                                </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="日志输出" FontSize="11" FontWeight="Bold" Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="清空日志" Click="BtnTeacherSimClearLog_Click" Style="{StaticResource GlassButton}" Background="#FF444444" Foreground="#FFCCCCCC" Height="22" FontSize="10" Padding="6,0" />
                                    </Grid>
                                    <TextBox x:Name="TextTeacherSimLog" Background="#FF050505" Foreground="#FF888888" FontSize="10" FontFamily="Consolas" Height="86" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" IsReadOnly="True" Padding="4" BorderThickness="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 快捷命令 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="快捷命令" FontSize="13" FontWeight="Bold" Foreground="#FF1a1a2e" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button Content="列出学生" Click="BtnTeacherSimQuickList_Click" Style="{StaticResource GlassButton}" Background="#FF007AFF" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="全部预览" Click="BtnTeacherSimQuickAll_Click" Style="{StaticResource GlassButton}" Background="#FF007AFF" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="黑屏全体" Click="BtnTeacherSimQuickBlackAll_Click" Style="{StaticResource GlassButton}" Background="#FFDC3545" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="解锁全体" Click="BtnTeacherSimQuickUnlockAll_Click" Style="{StaticResource GlassButton}" Background="#FF28A745" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="全体关机" Click="BtnTeacherSimQuickShutdownAll_Click" Style="{StaticResource GlassButton}" Background="#FFC5504B" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="全体重启" Click="BtnTeacherSimQuickRebootAll_Click" Style="{StaticResource GlassButton}" Background="#FFFFC107" Foreground="#FF000000" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="帮助" Click="BtnTeacherSimQuickHelp_Click" Style="{StaticResource GlassButton}" Background="#FF6C757D" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 目标操作快捷命令 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="目标操作（需先在控制台输入目标IP）" FontSize="13" FontWeight="Bold" Foreground="#FF1a1a2e" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目标IP:" FontSize="12" Foreground="#FF555566" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" x:Name="TextTeacherSimTargetIP" Text="" Style="{StaticResource GlassTextBox}" FontSize="12" Padding="6,4" Height="28" />
                                </Grid>
                                <TextBlock Text="提示：黑屏锁定/解锁、关机/重启等功能可能对部分系统（尤其是32位Win10）无效" FontSize="10" Foreground="#FF454545" Margin="0,0,0,6" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="发送消息" Click="BtnTeacherSimQuickMsg_Click" Style="{StaticResource GlassButton}" Background="#FF007AFF" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="群发消息" Click="BtnTeacherSimQuickMsgAll_Click" Style="{StaticResource GlassButton}" Background="#FF6F42C1" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="黑屏锁定" Click="BtnTeacherSimQuickBlack_Click" Style="{StaticResource GlassButton}" Background="#FFDC3545" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="解锁" Click="BtnTeacherSimQuickUnlock_Click" Style="{StaticResource GlassButton}" Background="#FF28A745" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="关机" Click="BtnTeacherSimQuickShutdown_Click" Style="{StaticResource GlassButton}" Background="#FFDC3545" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="重启" Click="BtnTeacherSimQuickReboot_Click" Style="{StaticResource GlassButton}" Background="#FFFFC107" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="屏幕预览" Click="BtnTeacherSimQuickPreview_Click" Style="{StaticResource GlassButton}" Background="#FF007AFF" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="启动观看" Click="BtnTeacherSimQuickView_Click" Style="{StaticResource GlassButton}" Background="#FF9C27B0" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="停止观看" Click="BtnTeacherSimQuickViewStop_Click" Style="{StaticResource GlassButton}" Background="#FF6C757D" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                    <Button Content="学生信息" Click="BtnTeacherSimQuickInfo_Click" Style="{StaticResource GlassButton}" Background="#FF6C757D" Height="30" Margin="0,0,6,6" FontSize="11" Padding="8,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 操作按钮 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTeacherSimStart" Content="启动模拟" Click="BtnTeacherSimStart_Click" Style="{StaticResource GlassButton}" Background="#FF28A745" Height="36" Margin="0,0,4,0" />
                            <Button Grid.Column="1" x:Name="BtnTeacherSimStop" Content="停止模拟" Click="BtnTeacherSimStop_Click" Style="{StaticResource GlassButton}" Background="#FFDC3545" Height="36" Margin="4,0,4,0" />
                            <Button Grid.Column="2" Content="清空控制台" Click="BtnTeacherSimClear_Click" Style="{StaticResource GlassButton}" Background="#FF6C757D" Height="36" Margin="4,0,0,0" />
                        </Grid>

                        <TextBlock Text="说明：本功能通过teacher_sim.exe模拟极域教师端，可查看学生屏幕、远程控制、发送消息等。控制台输入help查看所有命令。" FontSize="11" Foreground="#FF888899" TextWrapping="Wrap" Margin="0,8" />
                    </StackPanel>
                </ScrollViewer>


                <!-- 小游戏页面（扫雷 / 恐龙跳，GameContent 是游戏与菜单的宿主） -->
                <Grid x:Name="PageGames" Visibility="Collapsed">
                    <ContentControl x:Name="GameContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>

                <!-- 帮助文档页面 -->
                <Grid x:Name="PageHelp" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0" Text="帮助文档" FontSize="20" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,0,0,8" />

                    <!-- 子页面导航 -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,8">
                        <Button x:Name="HelpNavIntro" Content="介绍" Click="HelpNavIntro_Click" Style="{StaticResource GlassButton}" Background="#FF007BFF" Foreground="White" BorderBrush="Transparent" Padding="4,6" FontSize="12" />
                        <Button x:Name="HelpNavKey" Content="快捷键" Click="HelpNavKey_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF262626" BorderBrush="Transparent" Padding="4,6" FontSize="12" />
                        <Button x:Name="HelpNavAntiMonitor" Content="虚假反监视" Click="HelpNavAntiMonitor_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF262626" BorderBrush="Transparent" Padding="4,6" FontSize="12" />
                        <Button x:Name="HelpNavOthers" Content="其他" Click="HelpNavOthers_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF262626" BorderBrush="Transparent" Padding="4,6" FontSize="12" />
                        <Button x:Name="HelpNavDisclaimer" Content="免责声明" Click="HelpNavDisclaimer_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF262626" BorderBrush="Transparent" Padding="4,6" FontSize="12" />
                    </UniformGrid>

                    <!-- 内容区域 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="4,0,4,8">

                            <!-- 介绍 -->
                            <StackPanel x:Name="HelpContentIntro">
                                <TextBlock Text="简介" FontSize="16" FontWeight="Bold" Foreground="#FFFF8B0D" Margin="0,0,0,8" />
                                <TextBlock Text="本软件研发目的就是为了对抗极域电子教室，如果您的学校机房使用极域电子教室来控制学生电脑的话，本软件很可能会帮到你。" FontSize="13" Foreground="#FF006BEF" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="这是一个可以使极域电子教室全屏广播失效的软件，也就是说，在被老师全屏广播时，会将其自动调整为窗口模式，你不仅可以自由操作电脑，也还可以看老师的演示，自由+学习两不误。其还可以防止被老师控制，以及自动关闭「黑屏安静」这种东西；由于本软件是将全屏调整为窗口，因此老师并不会发现你断线或是进行了非法操作。" FontSize="13" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="主要功能" FontSize="14" FontWeight="Bold" Foreground="#FFFF8B0D" Margin="0,0,0,6" />
                                <TextBlock Text="• 在不影响极域正常运行的情况下将全屏的广播转为窗口广播模式" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="8,2,0,2" />
                                <TextBlock Text="• 内置强杀、启停极域 StudentMain.exe 进程功能" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="8,2,0,2" />
                                <TextBlock Text="• 内置破解极域解锁卸载密码功能，支持新版极域" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="8,2,0,2" />
                                <TextBlock Text="• 防监视功能，开启反监视，教师端就无法监视您所用的电脑" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="8,2,0,2" />
                                <TextBlock Text="• 防控制功能，防止教师通过极域控制您所用的电脑" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="8,2,0,2" />
                                <TextBlock Text="• 监控极域远程执行命令，您可以自由选择是否允许" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="8,2,0,2" />
                                <TextBlock Text="• 解除网络控制，防止教师限制您电脑的网络" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="8,2,0,8" />

                                <TextBlock Text="安装方法" FontSize="14" FontWeight="Bold" Foreground="#FFFF8B0D" Margin="0,0,0,6" />
                                <TextBlock Text="本软件不依赖任何运行库，您只需复制一个 学习不通.exe 至目标电脑即可运行，本软件已将需要的DLL打包，它会自动进行安装。" FontSize="13" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="操作方法" FontSize="14" FontWeight="Bold" Foreground="#FFFF8B0D" Margin="0,0,0,6" />
                                <TextBlock Text="本软件专为小白设计，默认情况下，您不需要修改任何参数，直接运行exe，并最小化即可，软件会自动进行操作。" FontSize="13" Foreground="#FF006BEF" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock Text="如果默认模式无法满足您的需求，可点主界面的「控制台和设置」进行自定义配置。" FontSize="13" Foreground="#FF0A0A0A" TextWrapping="Wrap" Margin="0,0,0,8" />

                            </StackPanel>
                            <!-- 虚假反监视 -->
                            <StackPanel x:Name="HelpContentAntiMonitor" Visibility="Collapsed">
                                <TextBlock Text="虚假反监视" FontSize="16" FontWeight="Bold" Foreground="#FFFF8B0D" Margin="0,0,0,8" />
