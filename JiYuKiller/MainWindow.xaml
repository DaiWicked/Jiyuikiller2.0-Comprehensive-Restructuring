                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 调试页面 -->
                <Grid x:Name="PageDebug" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnRefreshLog" Content="刷新日志" Style="{StaticResource GlassButton}" Click="BtnRefreshLog_Click" Margin="0,0,8,0" />
                        <Button x:Name="BtnOpenLogFolder" Content="打开日志目录" Style="{StaticResource GlassButton}" Click="BtnOpenLogFolder_Click" Background="#FF6C757D" />
                        <CheckBox x:Name="CheckDebugMode" Content="调试模式" Style="{StaticResource GlassCheckBox}" Margin="16,0,0,0" Checked="DebugMode_Checked" Unchecked="DebugMode_Unchecked" />
                    </StackPanel>

                    <TextBox x:Name="DebugLogBox" Grid.Row="1"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#FF1E1E1E"
                             Foreground="#FFD4D4D4"
                             BorderBrush="#FF333333"
                             BorderThickness="1"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>

            </Grid>

            <!-- 底部导航栏 -->
            <Border Grid.Row="2" Background="#10000000" CornerRadius="0,0,16,16">
                <UniformGrid Columns="4">
                    <Button x:Name="NavSetting" Content="控制台和设置" Click="NavSetting_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF333333" BorderBrush="Transparent" FontWeight="Bold" />
                    <Button x:Name="NavHelp" Content="帮助文档" Click="NavHelp_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF666666" BorderBrush="Transparent" />
                    <Button x:Name="NavDebug" Content="调试" Click="NavDebug_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF666666" BorderBrush="Transparent" />
                    <Button x:Name="NavAbout" Content="关于" Click="NavAbout_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF666666" BorderBrush="Transparent" />
                </UniformGrid>
            </Border>

        </Grid>
    </Border>
</Window>
