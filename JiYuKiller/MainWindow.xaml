                                    </StackPanel>

                                    <Button x:Name="BtnRefreshGlass" Content="刷新玻璃背景" Style="{StaticResource GlassButton}" Click="BtnRefreshGlass_Click" Padding="12,6" FontSize="12" HorizontalAlignment="Left" Margin="0,4,0,0" />
