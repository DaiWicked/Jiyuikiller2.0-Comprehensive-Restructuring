<Window x:Class="JiYuKiller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:JiYuKiller.Effects"
        Title="i.chaoxing Main Window"
        Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/学习不通;component/Assets/JiYuTrainerLogo.ico"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="True"
        MinWidth="400" MinHeight="450"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

    </Window.Resources>

    <!-- 窗口根容器（光晕层 + 主窗口） -->
    <Grid Background="Transparent">
        <!-- 窗口阴影层已删除（2026-09-17）：原实现是 Background="#01000000"(alpha=1) + DropShadowEffect，
             但 DropShadowEffect 只取元素的 alpha 通道 ⇒ 阴影强度 = 0.3 × (1/255) ≈ 0.001，
             受控测试（窗口在 / ShowWindow 隐藏各截一张全屏做差）实测窗口外一圈差值为 0 —— 
             它一点阴影都没画出来，属死代码；它唯一的作用是让外层玻璃缩进 8px（为不存在的阴影留空间）。
             删掉它并把 GlassContainer 的 Margin 归零：玻璃铺满窗口、全透明区域面积最小
             —— 在 DWM 合成关闭的老系统上，透明区域正是最容易出黑边/黑角的地方。 -->
        <!-- 外层玻璃容器（对角渐变边框, 描边留在这里不被裁剪） -->
        <Border x:Name="GlassContainer" CornerRadius="16" Margin="0" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#C0FFFFFF" Offset="0" />
                    <GradientStop Color="#80FFFFFF" Offset="0.3" />
                    <GradientStop Color="#40A8D0F0" Offset="0.7" />
                    <GradientStop Color="#2080B0D0" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

        <!-- 圆角裁剪根：Clip由C#按尺寸更新，半径=15（外圆角16-描边1，同心） -->
        <Grid x:Name="GlassClipRoot" ClipToBounds="True">
            <!-- 层1容器：桌面截图 + 白色覆盖 + 壁纸 -->
            <Border x:Name="BackdropContainer" CornerRadius="16" ClipToBounds="True">
                <Grid>
                    <Border x:Name="BackdropLayer" />
                    <Border x:Name="WhiteOverlayLayer" Background="#FFFFFFFF" />
                    <Border x:Name="WallpaperLayer" Background="#FFFFFFFF" />
                </Grid>
            </Border>

            <!-- 层2: 玻璃效果层，VisualBrush绑定整个容器 -->
            <Border x:Name="GlassyLayer" CornerRadius="16" ClipToBounds="True">
                <Border.Background>
                    <VisualBrush Visual="{Binding ElementName=BackdropContainer}" />
                </Border.Background>
            </Border>

            <!-- 层2.5: 光感层（借鉴COUI BloomStroke: 顶部光源RadialGradient, 顶部亮边缘暗） -->
            <Border x:Name="GlowLayer" CornerRadius="16" ClipToBounds="True" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.1" RadiusX="0.8" RadiusY="0.6" GradientOrigin="0.5,0.1">
                        <GradientStop Color="#40FFFFFF" Offset="0" />
                        <GradientStop Color="#15FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 层2.6: 噪声层（抗色带, 透明度0.04增强效果） -->
            <Border x:Name="NoiseLayer" CornerRadius="16" ClipToBounds="True" IsHitTestVisible="False" Opacity="0.04" />

            <!-- 层3: 内容层（透明背景） -->
            <Border x:Name="ContentLayer" Background="Transparent" CornerRadius="16" ClipToBounds="True">
                <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="90" />
                </Grid.RowDefinitions>

            <!-- 标题栏（整行可拖动，Background=Transparent确保空白区域也接收鼠标事件） -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/学习不通;component/Assets/JiYuTrainerLogo16.png" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="学习不通2.0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF0A0A0A" />
                    <!-- 设计期占位；运行时由 ApplySettingsToUI 用 _settings.Version 覆盖 -->
                    <TextBlock x:Name="VersionText" Text="QD_V2.9_JiYuRebuild_MeantToBe" FontSize="12" VerticalAlignment="Center" Foreground="#FF383838" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="BtnClose" Content="✕" Width="32" Height="28" Click="BtnClose_Click" Style="{StaticResource GlassButton}" Padding="0" FontSize="15" FontWeight="Bold" Background="Transparent" Foreground="#FF1A1A1A" BorderBrush="Transparent" />
                </StackPanel>
            </Grid>

            <!-- 内容区域 -->
            <Grid Grid.Row="1" Margin="16,8">
                <!-- 文字可读性光晕（不改任何透明度数值）
                     ShadowDepth=0 的白色投影 = 在字形外缘补一圈与桌面无关的亮底，
                     深色文字压到桌面暗部/杂乱区域时依然能分辨。
                     整页只做一次渲染合成（单张渲染目标），开销远低于逐控件加 Effect；
                     又因为卡片底色是半透明的，光晕强度按 alpha 自然衰减 —— 字形（不透明）亮、
                     卡片边缘（约 15% alpha）几乎看不见。 -->
                <Grid.Effect>
                    <DropShadowEffect Color="#FFFFFFFF" ShadowDepth="0" BlurRadius="2.5" Opacity="0.4" />
                </Grid.Effect>

                <!-- 设置页面 -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,0,0,8">
                        <!-- 进程控制分组 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="进程控制" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />

                                <CheckBox x:Name="CheckBanRunOp" Content="禁止极域运行进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域在此电脑上运行程序" />
                                <CheckBox x:Name="CheckProhibitKill" Content="禁止极域结束进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域结束您电脑上的进程" />
                            </StackPanel>
                        </Border>

                        <!-- 窗口控制分组 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="窗口控制" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckAllowTop" Content="允许屏幕广播窗口置顶" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许屏幕广播窗口置顶，默认不允许" />
                                <CheckBox x:Name="CheckProhibitClose" Content="禁止极域关闭窗口" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域关闭您电脑上的窗口" />
                            </StackPanel>
                        </Border>

                        <!-- 教师权限分组 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="教师权限" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckAllowMonitor" Content="允许教师监视你的电脑" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许教师通过极域查看你的电脑屏幕" />
                                <CheckBox x:Name="CheckAllowControl" Content="允许老师控制你的电脑" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许教师通过极域控制您的电脑" />
                            </StackPanel>
                        </Border>

                        <!-- 操作按钮 -->
                        <WrapPanel Margin="0,2,0,0">
                            <Button x:Name="BtnUnloadNetFilter" Content="解除网络控制" Style="{StaticResource GlassButton}" Click="BtnUnloadNetFilter_Click" Margin="0,0,6,6" />
                            <Button x:Name="BtnLoadDriver" Content="加载内核驱动" Style="{StaticResource GlassButton}" Click="BtnLoadDriver_Click" Background="#FF6F42C1" Margin="0,0,6,6" />
                            <Button x:Name="BtnUnloadDriver" Content="卸载内核驱动" Style="{StaticResource GlassButton}" Click="BtnUnloadDriver_Click" Background="#FF6C757D" Margin="0,0,6,6" />
                            <Button x:Name="BtnLocateJiYu" Content="选择极域路径" Style="{StaticResource GlassButton}" Click="BtnLocateJiYu_Click" Background="#FF6C757D" Margin="0,0,6,6" />
                            <Button x:Name="BtnReadJiYuPassword" Content="读取极域密码" Style="{StaticResource GlassButton}" Click="BtnReadJiYuPassword_Click" Background="#FF17A2B8" Margin="0,0,6,6" />
                            <Button x:Name="BtnAdvancedSettings" Content="软件高级设置" Style="{StaticResource GlassButton}" Click="BtnAdvancedSettings_Click" Background="#FFDC3545" Margin="0,0,6,6" />
                            <Button x:Name="BtnSaveSettings" Content="保存设置" Style="{StaticResource GlassButton}" Click="BtnSaveSettings_Click" Background="#FF28A745" Margin="0,0,6,6" />
                            <Button x:Name="BtnResetSettings" Content="恢复默认" Style="{StaticResource GlassButton}" Click="BtnResetSettings_Click" Background="#FFFFC107" Foreground="#FF0A0A0A" Margin="0,0,6,6" />
                        </WrapPanel>

                        <!-- 驱动状态 -->
                        <TextBlock x:Name="DriverStatusText" Text="驱动状态: 未加载" FontSize="11" Foreground="#FF404040" Margin="4,6,0,0" />
                        <!-- 极域路径显示 -->
                        <TextBlock x:Name="JiYuPathText" Text="极域路径: 未设置" FontSize="11" Foreground="#FF404040" Margin="4,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 快捷栏页面（液态玻璃卡片效果） -->
                <ScrollViewer x:Name="PageQuick" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,8">
                        <!-- 当前状态 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,12">
                            <Border CornerRadius="12" Background="#20000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#80FFFFFF" Offset="0" /><GradientStop Color="#30FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#48FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="14" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#50FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="当前状态" FontSize="12" Foreground="#FF383838" />
                                        <TextBlock x:Name="StatusText" Text="正在初始化..." FontSize="20" FontWeight="Bold" Foreground="#FF000000" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 极域控制 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#18000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0" /><GradientStop Color="#20FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="12" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="极域控制" FontSize="14" FontWeight="Bold" Foreground="#FF000000" Margin="0,0,0,8" />
                                        <UniformGrid Columns="2">
                                            <Button x:Name="BtnKillJiYu" Content="杀死极域" Style="{StaticResource GlassButton}" Click="BtnKillJiYu_Click" Background="#FFDC3545" Margin="0,0,4,0" />
                                            <Button x:Name="BtnRestartJiYu" Content="重启极域" Style="{StaticResource GlassButton}" Click="BtnRestartJiYu_Click" Background="#FF28A745" Margin="4,0,0,0" />
                                        </UniformGrid>
                                        <TextBlock x:Name="TextJiYuStatus" Text="极域状态: 检测中..." FontSize="11" Foreground="#FF404040" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 窗口控制 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#18000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0" /><GradientStop Color="#20FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="12" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="窗口控制" FontSize="14" FontWeight="Bold" Foreground="#FF000000" Margin="0,0,0,8" />
                                        <Button x:Name="BtnTopMost" Content="本窗口置顶" Style="{StaticResource GlassButton}" Click="BtnTopMost_Click" Background="#FF007BFF" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 电源控制 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#18000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0" /><GradientStop Color="#20FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="12" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="电源控制" FontSize="14" FontWeight="Bold" Foreground="#FF000000" Margin="0,0,0,8" />
                                        <UniformGrid Columns="3">
                                            <Button x:Name="BtnShutdown" Content="关机" Style="{StaticResource GlassButton}" Click="BtnShutdown_Click" Background="#FFDC3545" Margin="0,0,4,0" />
                                            <Button x:Name="BtnReboot" Content="重启" Style="{StaticResource GlassButton}" Click="BtnReboot_Click" Background="#FFFFC107" Foreground="#FF000000" Margin="4,0,4,0" />
                                            <Button x:Name="BtnExitApp" Content="退出" Style="{StaticResource GlassButton}" Click="BtnExitApp_Click" Background="#FF6C757D" Margin="4,0,0,0" />
                                        </UniformGrid>
                                        <TextBlock Text="注：关机/重启前会自动停止极域控制" FontSize="11" Foreground="#FF404040" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 关于页面 -->
                <Grid x:Name="PageAbout" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                            <Image Source="pack://application:,,,/学习不通;component/Assets/about.png" Width="280" Margin="0,0,0,16" Stretch="Uniform" />
                            <TextBlock Text="学习不通2.0" FontSize="24" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" />
                            <!-- 设计期占位；运行时由 ApplySettingsToUI 用 _settings.Version 覆盖 -->
                            <TextBlock x:Name="AboutVersion" Text="QD_V2.9_JiYuRebuild_MeantToBe" FontSize="14" Foreground="#FF383838" HorizontalAlignment="Center" Margin="0,4,0,16" MouseLeftButtonDown="AboutVersion_MouseLeftButtonDown" Cursor="Hand" />
                            <TextBlock Text="基于 JiYuTrainer 重构的 C# WPF 版本" FontSize="12" Foreground="#FF262626" HorizontalAlignment="Center" />

                            <!-- 致谢 -->
                            <TextBlock Text="致谢" FontSize="15" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="原作者: imengyu" FontSize="12" Foreground="#FF262626" Margin="0,0,16,0" />
                                <TextBlock Text="二改作者: zsyn666" FontSize="12" Foreground="#FF262626" />
                            </StackPanel>

                            <!-- 关于我入口 -->
                            <Button x:Name="BtnAboutMe" Content="关于我" Style="{StaticResource GlassButton}" Click="BtnAboutMe_Click" Margin="0,20,0,0" Width="100" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 关于我页面 -->
                <Grid x:Name="PageAboutMe" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                            <!-- 返回按钮 -->
                            <Button x:Name="BtnBackFromAboutMe" Content="← 返回" Style="{StaticResource GlassButton}" Click="BtnBackFromAboutMe_Click" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#FF6C757D" Padding="12,6" />

                            <!-- 头像 -->
                            <!-- 注意: ClipToBounds 只做矩形裁剪, 圆角必须靠 Border.Clip 的 RectangleGeometry -->
                            <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,16" ClipToBounds="True">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,120,120" RadiusX="60" RadiusY="60" />
                                </Border.Clip>
                                <Image Source="pack://application:,,,/学习不通;component/Assets/me.png" Stretch="UniformToFill" />
                            </Border>

                            <!-- 标题 -->
                            <TextBlock Text="关于我" FontSize="24" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="作者: Daitangxin" FontSize="15" Foreground="#FF1A1A1A" HorizontalAlignment="Center" Margin="0,0,0,16" />

                            <!-- 内容简介 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="16,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="内容简介" FontSize="13" FontWeight="Bold" Foreground="#FF383838" Margin="0,0,0,8" />
                                    <TextBlock Text="创始人 / 程序员 / 摄影师" FontSize="14" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="缺德组织 CEO" FontSize="14" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="缺德组织核心人员之一" FontSize="14" Foreground="#FF0A0A0A" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- GitHub 链接 -->
                            <Button x:Name="BtnGithub" Content="GitHub 仓库" Style="{StaticResource GlassButton}" Click="BtnGithub_Click" Margin="0,16,0,0" Width="140" Background="#FF24292E" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 极客工具页面 -->


                <!-- 极域UDP攻击页面 -->
                <!-- 极域UDP攻击页面 -->
                <ScrollViewer x:Name="PageUdpAttack" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,8">
                        <!-- 标题栏 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnBackFromUdpAttack" Content="←" Click="BtnBackFromUdpAttack_Click" Style="{StaticResource GlassButton}" Background="#20000000" Foreground="#FF1A1A1A" BorderBrush="Transparent" Padding="12,6" FontSize="14" Grid.Column="0" HorizontalAlignment="Left" />
                            <TextBlock Text="极域 UDP 攻击" FontSize="18" FontWeight="Bold" Foreground="#FF0A0A0A" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 目标配置 -->
                        <Border Background="#18000000" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目标配置" FontSize="13" FontWeight="Bold" Foreground="#FF1A1A1A" Grid.Column="0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TextUdpLocalInfo" Text="本机: 获取中..." FontSize="10" Foreground="#FF454545" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="目标 IP 地址" FontSize="11" Foreground="#FF383838" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextUdpTargetIp" Text="" Style="{StaticResource GlassTextBox}" Grid.Column="0" Margin="0,0,6,0" FontSize="13" Padding="8,6" />
                                    <Button x:Name="BtnScanLan" Content="扫描局域网" Click="BtnScanLan_Click" Style="{StaticResource GlassButton}" Grid.Column="1" Padding="12,6" FontSize="12" Background="#FF4A90D9" Foreground="#FFFFFFFF" />
                                </Grid>
                                <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <ListBox x:Name="ListUdpScanResult" Height="100" FontSize="11" Foreground="#FF1A1A1A" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionChanged="ListUdpScanResult_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="6,3" />
                                                <Setter Property="Cursor" Value="Hand" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 消息/命令内容 -->
                        <Border Background="#18000000" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="消息 / 命令内容" FontSize="13" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                <TextBox x:Name="TextUdpMessage" Text="Hello from 学习不通2.0" Style="{StaticResource GlassTextBox}" FontSize="13" Padding="8,6" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" />
                                <TextBlock Text="命令规范：输入 system32 目录下的可执行文件名（如 notepad.exe / calc.exe / cmd.exe / mspaint.exe），将在学生端运行 C:\Windows\system32\&lt;输入内容&gt;" FontSize="10" Foreground="#FF454545" Margin="0,6,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="快捷指令：" FontSize="11" Foreground="#FF555566" Margin="0,0,0,4" />
                                <TextBlock Text="快捷指令（可能对部分系统无效）：" FontSize="11" Foreground="#FF555566" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <Button Content="记事本" Click="BtnUdpQuickCmd_Click" Tag="notepad.exe" Style="{StaticResource GlassButton}" Background="#20000000" Foreground="#FF1A1A1A" BorderBrush="Transparent" Height="26" Margin="0,0,6,4" FontSize="11" Padding="8,0" />
                                    <Button Content="画图" Click="BtnUdpQuickCmd_Click" Tag="mspaint.exe" Style="{StaticResource GlassButton}" Background="#20000000" Foreground="#FF1A1A1A" BorderBrush="Transparent" Height="26" Margin="0,0,6,4" FontSize="11" Padding="8,0" />
                                    <Button Content="写字板" Click="BtnUdpQuickCmd_Click" Tag="write.exe" Style="{StaticResource GlassButton}" Background="#20000000" Foreground="#FF1A1A1A" BorderBrush="Transparent" Height="26" Margin="0,0,6,4" FontSize="11" Padding="8,0" />
                                    <Button Content="字符映射表" Click="BtnUdpQuickCmd_Click" Tag="charmap.exe" Style="{StaticResource GlassButton}" Background="#20000000" Foreground="#FF1A1A1A" BorderBrush="Transparent" Height="26" Margin="0,0,6,4" FontSize="11" Padding="8,0" />
                                    <Button Content="屏幕键盘" Click="BtnUdpQuickCmd_Click" Tag="osk.exe" Style="{StaticResource GlassButton}" Background="#20000000" Foreground="#FF1A1A1A" BorderBrush="Transparent" Height="26" Margin="0,0,6,4" FontSize="11" Padding="8,0" />
                                    <Button Content="放大镜" Click="BtnUdpQuickCmd_Click" Tag="magnify.exe" Style="{StaticResource GlassButton}" Background="#20000000" Foreground="#FF1A1A1A" BorderBrush="Transparent" Height="26" Margin="0,0,6,4" FontSize="11" Padding="8,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 攻击操作 -->
                        <Border Background="#18000000" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="攻击操作" FontSize="13" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnUdpSendMsg" Content="发送消息" Click="BtnUdpSendMsg_Click" Style="{StaticResource GlassButton}" Grid.Column="0" Margin="0,0,4,0" Padding="8,10" FontSize="13" Background="#FF5B9BD5" Foreground="#FFFFFFFF" />
                                    <Button x:Name="BtnUdpSendCmd" Content="发送命令" Click="BtnUdpSendCmd_Click" Style="{StaticResource GlassButton}" Grid.Column="1" Margin="4,0,0,0" Padding="8,10" FontSize="13" Background="#FF70AD47" Foreground="#FFFFFFFF" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnUdpShutdown" Content="远程关机" Click="BtnUdpShutdown_Click" Style="{StaticResource GlassButton}" Grid.Column="0" Margin="0,0,4,0" Padding="8,10" FontSize="13" Background="#FFC5504B" Foreground="#FFFFFFFF" />
                                    <Button x:Name="BtnUdpReboot" Content="远程重启" Click="BtnUdpReboot_Click" Style="{StaticResource GlassButton}" Grid.Column="1" Margin="4,0,0,0" Padding="8,10" FontSize="13" Background="#FFED7D31" Foreground="#FFFFFFFF" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 操作日志 -->
                        <Border Background="#18000000" CornerRadius="12" Padding="14" Margin="0,0,0,4">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="操作日志" FontSize="13" FontWeight="Bold" Foreground="#FF1A1A1A" Grid.Column="0" />
                                    <Button x:Name="BtnUdpClearLog" Content="清空" Click="BtnUdpClearLog_Click" Style="{StaticResource GlassButton}" Grid.Column="1" Padding="8,4" FontSize="11" Background="#20000000" Foreground="#FF383838" BorderBrush="Transparent" />
                                </Grid>
                                <TextBox x:Name="TextUdpLog" Text="等待操作..." Style="{StaticResource GlassTextBox}" Height="140" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" IsReadOnly="True" FontSize="11" Padding="8" Background="#0A000000" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 软件高级设置页面 -->
                <Grid x:Name="PageAdvancedSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnBackFromAdvanced" Content="← 返回" Style="{StaticResource GlassButton}" Click="BtnBackFromAdvanced_Click" Background="#FF6C757D" Padding="12,6" />
                        <TextBlock Grid.Column="1" Text="软件高级参数配置" FontSize="18" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 内容区域 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="0,0,0,8">
                            <!-- 驱动设置 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="驱动设置" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckDisableDriver" Content="禁用软件内核驱动" Style="{StaticResource GlassCheckBox}" ToolTip="禁用后将不加载内核驱动，部分功能不可用" />
                                    <CheckBox x:Name="CheckSelfProtect" Content="驱动层自我保护" Style="{StaticResource GlassCheckBox}" ToolTip="通过驱动防止本软件被结束" />
                                    <TextBlock x:Name="DriverHintText" Text="注：需先在设置页面加载内核驱动" FontSize="11" Foreground="#FF404040" Margin="4,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 极域附加控制 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="极域附加控制" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckAutoForceKill" Content="不客气模式（自动强制清除）" Style="{StaticResource GlassCheckBox}" ToolTip="操作失败时直接清除极域有关进程，不建议使用" />
                                    <CheckBox x:Name="CheckAutoIncludeFullWindow" Content="严格窗口控制模式" Style="{StaticResource GlassCheckBox}" ToolTip="严格控制极域所有窗口，不仅仅是屏幕广播和黑屏窗口" />
                                </StackPanel>
                            </Border>

                            <!-- 程序隐藏 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="程序隐藏" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckDoNotShowVirusWindow" Content="隐藏极域端控制输出窗口" Style="{StaticResource GlassCheckBox}" ToolTip="隐藏屏幕左上角的极域控制输出窗口" />
                                    <CheckBox x:Name="CheckDoNotShowTrayIcon" Content="隐藏本软件任务栏图标" Style="{StaticResource GlassCheckBox}" ToolTip="隐藏后可使用快捷键显示或隐藏主窗口" Checked="CheckDoNotShowTrayIcon_Checked" Unchecked="CheckDoNotShowTrayIcon_Unchecked" />
                                </StackPanel>
                            </Border>

                            <!-- 快捷键 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="快捷键（保存设置后立即生效）" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="紧急全屏快捷键" VerticalAlignment="Center" Foreground="#FF0A0A0A" FontSize="13" />
                                        <TextBox x:Name="TextHotKeyFakeFull" Grid.Column="1" Text="Ctrl+Alt+F" Height="26" FontSize="12"
                                                 TextAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 Cursor="Hand" Style="{StaticResource GlassTextBox}" PreviewKeyDown="HotKeyBox_PreviewKeyDown"
                                                 ToolTip="点这里，然后直接按下想要的组合键（须含 Ctrl/Alt/Shift/Win 至少一个）" />
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示/隐藏窗口快捷键" VerticalAlignment="Center" Foreground="#FF0A0A0A" FontSize="13" />
                                        <TextBox x:Name="TextHotKeyShowHide" Grid.Column="1" Text="Ctrl+Alt+H" Height="26" FontSize="12"
                                                 TextAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 Cursor="Hand" Style="{StaticResource GlassTextBox}" PreviewKeyDown="HotKeyBox_PreviewKeyDown"
                                                 ToolTip="点这里，然后直接按下想要的组合键（须含 Ctrl/Alt/Shift/Win 至少一个）" />
                                    </Grid>
                                    <TextBlock Text="注：点进输入框后直接按下组合键即可修改；保存设置后立即生效。" FontSize="11" Foreground="#FF454545" Margin="4,4,0,0" />
                                    <!-- 注册失败提示：默认隐藏，由 RegisterGlobalHotKeys 按真实结果填充（原来只在日志里写 INFO，界面上看不出来） -->
                                    <TextBlock x:Name="TextHotKeyWarn" Text="" Visibility="Collapsed" FontSize="11" Foreground="#FFC0392B" TextWrapping="Wrap" Margin="4,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 结束进程模式 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="结束进程模式" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <RadioButton x:Name="RadioKillTP" Content="TerminateProcess (Weak)" GroupName="KillProcess" Foreground="#FF0A0A0A" FontSize="13" Margin="0,2" />
                                    <RadioButton x:Name="RadioKillNTP" Content="NtTerminateProcess (Default)" GroupName="KillProcess" Foreground="#FF0A0A0A" FontSize="13" Margin="0,2" />
                                    <RadioButton x:Name="RadioKillKernel" Content="KernelMode (需驱动)" GroupName="KillProcess" Foreground="#FF0A0A0A" FontSize="13" Margin="0,2" />
                                </StackPanel>
                            </Border>

                            <!-- DLL 注入 -->
                            <!-- 原「注入模式(RemoteThread/HookDllStub)」下拉框与「同时注入 MasterHelper」复选框已移除：
                                 这两个设置在上游 JiYuTrainer 里也只有配置界面读/写、没有任何代码消费，属死选项，
                                 留着只会让人以为选了会生效。详见 docs 与交接说明。 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DLL 注入" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <TextBlock Text="注入由远程线程执行；检测到极域进程后自动进行，无需配置。" FontSize="12" Foreground="#FF0A0A0A" TextWrapping="Wrap" />
                                    <TextBlock Text="注：上游的「注入模式(RemoteThread/HookDllStub)」与「同时注入 MasterHelper」从未被实现，本版已移除。" FontSize="11" Foreground="#FF404040" Margin="4,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 高级程序配置 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="高级程序配置" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckForceInstallInCurrentDir" Content="强制安装在当前目录" Style="{StaticResource GlassCheckBox}" ToolTip="勾选后驱动/DLL 释放到本程序所在目录（适合放 U 盘便携使用）；不勾则释放到 %LOCALAPPDATA%\学习不通。已释放的文件需重启生效。" />
                                    <CheckBox x:Name="CheckForceDisableWatchDog" Content="强制禁用看门狗" Style="{StaticResource GlassCheckBox}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="检查间隔(ms):" VerticalAlignment="Center" Foreground="#FF0A0A0A" FontSize="13" Margin="0,0,8,0" />
                                        <TextBox x:Name="TextCKInterval" Grid.Column="1" Text="3100" Style="{StaticResource GlassTextBox}" Height="26" FontSize="13" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="范围: 1000-10000" VerticalAlignment="Center" Foreground="#FF404040" FontSize="11" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 控制器启停 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="自动控制器启停" FontSize="14" FontWeight="Bold" Foreground="#FF1A1A1A" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckEnableController" Content="启用控制器" Style="{StaticResource GlassCheckBox}" Checked="CheckEnableController_Checked" Unchecked="CheckEnableController_Unchecked" />
                                    <TextBlock Text="控制器负责检查和控制极域，关闭将导致极域脱离控制。不建议关闭，仅调试时使用。" FontSize="11" Foreground="#FF404040" Margin="4,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 保存按钮 -->
                            <Button x:Name="BtnSaveAdvancedSettings" Content="保存高级设置" Style="{StaticResource GlassButton}" Click="BtnSaveAdvancedSettings_Click" Background="#FF28A745" Margin="0,4,0,0" Height="36" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- 小小私聊页面 -->
                <ScrollViewer x:Name="PageChat" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <StackPanel Margin="16,12">
                        <!-- 标题栏 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="←" Click="BtnChatBack_Click" Style="{StaticResource GlassButton}" Width="36" Height="32" FontSize="14" Padding="0" />
                            <TextBlock Grid.Column="1" Text="小小私聊 (beta)" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FF1a1a2e" />
                        </Grid>

                        <!-- 本机信息 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <TextBlock x:Name="TextChatLocalInfo" Text="本机信息获取中..." FontSize="13" Foreground="#FF2d2d44" TextWrapping="Wrap" />
                        </Border>

                        <!-- 目标配置 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="目标座位号" FontSize="14" FontWeight="Bold" Foreground="#FF1a1a2e" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextChatTargetSeat" Style="{StaticResource GlassTextBox}" Height="32" VerticalContentAlignment="Center" InputScope="Number" />
                                    <Button Grid.Column="1" Content="查找同学" Click="BtnChatFind_Click" Style="{StaticResource GlassButton}" Background="#FF007AFF" Margin="8,0,0,0" Height="32" Padding="12,0" />
                                </Grid>
                                <TextBlock x:Name="TextChatTargetStatus" Text="未查找" FontSize="12" Foreground="#FF666680" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 消息内容 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="消息内容 (最多80字)" FontSize="14" FontWeight="Bold" Foreground="#FF1a1a2e" Margin="0,0,0,6" />
                                <TextBox x:Name="TextChatMessage" Style="{StaticResource GlassTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Hidden" />
                                <Button Content="发送消息" Click="BtnChatSend_Click" Style="{StaticResource GlassButton}" Background="#FF28A745" Margin="0,8,0,0" Height="36" />
                            </StackPanel>
                        </Border>

                        <!-- 聊天记录 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="聊天记录" FontSize="14" FontWeight="Bold" Foreground="#FF1a1a2e" VerticalAlignment="Center" />
                                    <Button Content="清空" Click="BtnChatClear_Click" Style="{StaticResource GlassButton}" Width="56" Height="26" FontSize="11" Padding="0" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBox x:Name="TextChatLog" Style="{StaticResource GlassTextBox}" Height="160" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Hidden" FontFamily="Consolas" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="原理：极域学生端不对UDP包做身份验证，可构造数据包发送消息。座位号按6人一排布局推算。" FontSize="11" Foreground="#FF888899" TextWrapping="Wrap" Margin="0,4" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 虚假反监视页面 -->
                <ScrollViewer x:Name="PageScreenshot" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <StackPanel Margin="16,12">
                        <!-- 标题栏 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="←" Click="BtnScreenshotBack_Click" Style="{StaticResource GlassButton}" Width="36" Height="32" FontSize="14" Padding="0" />
                            <TextBlock Grid.Column="1" Text="虚假反监视" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FF1a1a2e" />
                        </Grid>

                        <!-- 缩略图替换 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="缩略图替换" FontSize="15" FontWeight="Bold" Foreground="#FF1a1a2e" VerticalAlignment="Center" />
                                    <Ellipse x:Name="ScreenshotStatusDot" Grid.Column="1" HorizontalAlignment="Right" Width="12" Height="12" Fill="#FF999999" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="教师端学生列表中的80×60缩略图。应用后自动重启极域学生端生效。" FontSize="11" Foreground="#FF888899" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <!-- 缩略图预览 -->
