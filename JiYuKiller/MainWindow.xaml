                                <Border Background="#20000000" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Ctrl + Alt + D" FontSize="14" FontWeight="Bold" Foreground="#FF333333" />
                                        <TextBlock Text="快速显示/隐藏窗口" FontSize="12" Foreground="#FF666666" Margin="0,4,0,0" />
                                        <TextBlock Text="这个快捷键在老师来的时候用来快速隐藏学习不通的窗口。" FontSize="11" Foreground="#FF333333" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#20000000" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Ctrl + Alt + F" FontSize="14" FontWeight="Bold" Foreground="#FF333333" />
                                        <TextBlock Text="紧急全屏" FontSize="12" Foreground="#FF666666" Margin="0,4,0,0" />
                                        <TextBlock Text="这个快捷键在老师来的时候快速把窗口调成全屏，等老师走后再次按这个快捷键重新切换回窗口（教师端开启了全屏广播这个快捷键才有效）。" FontSize="11" Foreground="#FF333333" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="提示：您可以在 软件高级设置 中自定义快捷键。" FontSize="11" Foreground="#FF999999" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 其他 -->
                            <StackPanel x:Name="HelpContentOthers" Visibility="Collapsed">
