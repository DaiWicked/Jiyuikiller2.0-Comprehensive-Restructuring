<Window x:Class="JiYuKiller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="学习不通"
        Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/JiYuTrainerLogo.ico"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        MinWidth="400" MinHeight="450">

    <Window.Resources>
        <!-- 页面切换动画 -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>
    </Window.Resources>

    <!-- 窗口根容器（光晕层 + 主窗口） -->
    <Grid Background="Transparent">
        <!-- 外层光晕虚化（模拟玻璃边缘光线散射） -->
        <Border x:Name="OuterGlow" Margin="2" CornerRadius="24" Background="#60C8E8FF" Opacity="0.2" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="28" />
            </Border.Effect>
        </Border>
        <!-- 第二层柔和光晕 -->
        <Border x:Name="InnerGlow" Margin="3" CornerRadius="20" Background="#80FFFFFF" Opacity="0.3" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="16" />
            </Border.Effect>
        </Border>

        <!-- 外层玻璃容器 -->
        <Border x:Name="GlassContainer" CornerRadius="16" Margin="8">
            <Border.BorderBrush>
                <SolidColorBrush Color="#60FFFFFF" />
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>

        <Grid>
            <!-- 层1: 桌面截图背景（毛玻璃底层） -->
            <Border x:Name="BackdropLayer" CornerRadius="16" ClipToBounds="True" />

            <!-- 层2: 玻璃像素着色器效果层（折射/模糊），背景绑定到截图层 -->
            <Border x:Name="GlassyLayer" CornerRadius="16" Background="{Binding Background, ElementName=BackdropLayer}" ClipToBounds="True" />

            <!-- 层3: 半透明白色覆盖层 + 内容（圆角裁剪） -->
            <Border x:Name="ContentLayer" Background="#80FFFFFF" CornerRadius="16" ClipToBounds="True">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

            <!-- 标题栏（整行可拖动，Background=Transparent确保空白区域也接收鼠标事件） -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/JiYuTrainerLogo16.png" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="学习不通" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF0A0A0A" />
                    <TextBlock x:Name="VersionText" Text="QD_V2.0" FontSize="12" VerticalAlignment="Center" Foreground="#FF555555" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="BtnMinimize" Content="─" Width="32" Height="28" Click="BtnMinimize_Click" Style="{StaticResource GlassButton}" Padding="0" FontSize="13" Background="Transparent" Foreground="#FF3A3A3A" BorderBrush="Transparent" />
                    <Button x:Name="BtnClose" Content="✕" Width="32" Height="28" Click="BtnClose_Click" Style="{StaticResource GlassButton}" Padding="0" FontSize="13" Background="Transparent" Foreground="#FF3A3A3A" BorderBrush="Transparent" />
                </StackPanel>
            </Grid>

            <!-- 内容区域 -->
            <Grid Grid.Row="1" Margin="16,8">

                <!-- 设置页面 -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        <!-- 进程控制分组 -->
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="进程控制" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckMonitorProcess" Content="监控极域运行进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="监控极域运行进程，教师可通过极域远程执行应用程序" />
                                <CheckBox x:Name="CheckBanRunOp" Content="禁止极域运行进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域在此电脑上运行程序" />
                                <CheckBox x:Name="CheckProhibitKill" Content="禁止极域结束进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域结束您电脑上的进程" />
                            </StackPanel>
                        </Border>

                        <!-- 窗口控制分组 -->
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="窗口控制" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckAllowTop" Content="允许屏幕广播窗口置顶" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许屏幕广播窗口置顶，默认不允许" />
                                <CheckBox x:Name="CheckProhibitClose" Content="禁止极域关闭窗口" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域关闭您电脑上的窗口" />
                            </StackPanel>
                        </Border>

                        <!-- 教师权限分组 -->
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="教师权限" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckAllowMonitor" Content="允许教师监视你的电脑" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许教师通过极域查看你的电脑屏幕" />
                                <CheckBox x:Name="CheckAllowControl" Content="允许老师控制你的电脑" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许教师通过极域控制您的电脑" />
                            </StackPanel>
                        </Border>

                        <!-- 操作按钮 -->
                        <WrapPanel Margin="0,2,0,0">
                            <Button x:Name="BtnUnloadNetFilter" Content="解除网络控制" Style="{StaticResource GlassButton}" Click="BtnUnloadNetFilter_Click" Margin="0,0,6,6" />
                            <Button x:Name="BtnLoadDriver" Content="加载内核驱动" Style="{StaticResource GlassButton}" Click="BtnLoadDriver_Click" Background="#FF6F42C1" Margin="0,0,6,6" />
                            <Button x:Name="BtnUnloadDriver" Content="卸载内核驱动" Style="{StaticResource GlassButton}" Click="BtnUnloadDriver_Click" Background="#FF6C757D" Margin="0,0,6,6" />
                            <Button x:Name="BtnLocateJiYu" Content="选择极域路径" Style="{StaticResource GlassButton}" Click="BtnLocateJiYu_Click" Background="#FF6C757D" Margin="0,0,6,6" />
                            <Button x:Name="BtnAdvancedSettings" Content="软件高级设置" Style="{StaticResource GlassButton}" Click="BtnAdvancedSettings_Click" Background="#FFDC3545" Margin="0,0,6,6" />
                            <Button x:Name="BtnSaveSettings" Content="保存设置" Style="{StaticResource GlassButton}" Click="BtnSaveSettings_Click" Background="#FF28A745" Margin="0,0,6,6" />
                            <Button x:Name="BtnResetSettings" Content="恢复默认" Style="{StaticResource GlassButton}" Click="BtnResetSettings_Click" Background="#FFFFC107" Foreground="#FF0A0A0A" Margin="0,0,6,6" />
                        </WrapPanel>

                        <!-- 驱动状态 -->
                        <TextBlock x:Name="DriverStatusText" Text="驱动状态: 未加载" FontSize="11" Foreground="#FF666666" Margin="4,6,0,0" />
                        <!-- 极域路径显示 -->
                        <TextBlock x:Name="JiYuPathText" Text="极域路径: 未设置" FontSize="11" Foreground="#FF666666" Margin="4,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 快捷栏页面（液态玻璃卡片效果） -->
                <ScrollViewer x:Name="PageQuick" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,8">
                        <!-- 当前状态 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,12">
                            <Border CornerRadius="12" Background="#20000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#80FFFFFF" Offset="0" /><GradientStop Color="#30FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#48FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="14" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#50FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="当前状态" FontSize="12" Foreground="#FF555555" />
                                        <TextBlock x:Name="StatusText" Text="正在初始化..." FontSize="20" FontWeight="Bold" Foreground="#FF000000" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 极域控制 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#18000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0" /><GradientStop Color="#20FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="12" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="极域控制" FontSize="14" FontWeight="Bold" Foreground="#FF000000" Margin="0,0,0,8" />
                                        <UniformGrid Columns="2">
                                            <Button x:Name="BtnKillJiYu" Content="杀死极域" Style="{StaticResource GlassButton}" Click="BtnKillJiYu_Click" Background="#FFDC3545" Margin="0,0,4,0" />
                                            <Button x:Name="BtnRestartJiYu" Content="重启极域" Style="{StaticResource GlassButton}" Click="BtnRestartJiYu_Click" Background="#FF28A745" Margin="4,0,0,0" />
                                        </UniformGrid>
                                        <TextBlock x:Name="TextJiYuStatus" Text="极域状态: 检测中..." FontSize="11" Foreground="#FF666666" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 窗口控制 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#18000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0" /><GradientStop Color="#20FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="12" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="窗口控制" FontSize="14" FontWeight="Bold" Foreground="#FF000000" Margin="0,0,0,8" />
                                        <Button x:Name="BtnTopMost" Content="本窗口置顶" Style="{StaticResource GlassButton}" Click="BtnTopMost_Click" Background="#FF007BFF" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 电源控制 - 玻璃卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Border CornerRadius="12" Background="#18000000" Margin="0,4,0,-2" Opacity="0.5"><Border.Effect><BlurEffect Radius="8" /></Border.Effect></Border>
                            <Border CornerRadius="12" BorderThickness="1" Padding="14">
                                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#70FFFFFF" Offset="0" /><GradientStop Color="#28FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#38FFFFFF" Offset="0" /><GradientStop Color="#20FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Border CornerRadius="12,12,0,0" Height="12" VerticalAlignment="Top" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                    <StackPanel>
                                        <TextBlock Text="电源控制" FontSize="14" FontWeight="Bold" Foreground="#FF000000" Margin="0,0,0,8" />
                                        <UniformGrid Columns="3">
                                            <Button x:Name="BtnShutdown" Content="关机" Style="{StaticResource GlassButton}" Click="BtnShutdown_Click" Background="#FFDC3545" Margin="0,0,4,0" />
                                            <Button x:Name="BtnReboot" Content="重启" Style="{StaticResource GlassButton}" Click="BtnReboot_Click" Background="#FFFFC107" Foreground="#FF000000" Margin="4,0,4,0" />
                                            <Button x:Name="BtnExitApp" Content="退出" Style="{StaticResource GlassButton}" Click="BtnExitApp_Click" Background="#FF6C757D" Margin="4,0,0,0" />
                                        </UniformGrid>
                                        <TextBlock Text="注：关机/重启前会自动停止极域控制" FontSize="11" Foreground="#FF666666" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 关于页面 -->
                <Grid x:Name="PageAbout" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                            <Image Source="Assets/about.png" Width="280" Margin="0,0,0,16" Stretch="Uniform" />
                            <TextBlock Text="学习不通" FontSize="24" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" />
                            <TextBlock x:Name="AboutVersion" Text="QD_V2.0_JiYuRebuild-TEST" FontSize="14" Foreground="#FF555555" HorizontalAlignment="Center" Margin="0,4,0,16" />
                            <TextBlock Text="基于 JiYuTrainer 重构的 C# WPF 版本" FontSize="12" Foreground="#FF3A3A3A" HorizontalAlignment="Center" />

                            <!-- 致谢 -->
                            <TextBlock Text="致谢" FontSize="15" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="原作者: imengyu" FontSize="12" Foreground="#FF3A3A3A" Margin="0,0,16,0" />
                                <TextBlock Text="二改作者: zsyn666" FontSize="12" Foreground="#FF3A3A3A" />
                            </StackPanel>

                            <!-- 关于我入口 -->
                            <Button x:Name="BtnAboutMe" Content="关于我" Style="{StaticResource GlassButton}" Click="BtnAboutMe_Click" Margin="0,20,0,0" Width="100" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 关于我页面 -->
                <Grid x:Name="PageAboutMe" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                            <!-- 返回按钮 -->
                            <Button x:Name="BtnBackFromAboutMe" Content="← 返回" Style="{StaticResource GlassButton}" Click="BtnBackFromAboutMe_Click" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#FF6C757D" Padding="12,6" />

                            <!-- 头像 -->
                            <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,16" ClipToBounds="True">
                                <Image Source="Assets/me.png" Stretch="UniformToFill" />
                            </Border>

                            <!-- 标题 -->
                            <TextBlock Text="关于我" FontSize="24" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="作者: Daitangxin" FontSize="15" Foreground="#FF2A2A2A" HorizontalAlignment="Center" Margin="0,0,0,16" />

                            <!-- 内容简介 -->
                            <Border Background="#20000000" CornerRadius="8" Padding="16" Margin="16,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="内容简介" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <TextBlock Text="创始人 / 程序员 / 摄影师" FontSize="14" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="缺德组织 CEO" FontSize="14" Foreground="#FF0A0A0A" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="缺德组织核心人员之一" FontSize="14" Foreground="#FF0A0A0A" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- GitHub 链接 -->
                            <Button x:Name="BtnGithub" Content="GitHub 仓库" Style="{StaticResource GlassButton}" Click="BtnGithub_Click" Margin="0,16,0,0" Width="140" Background="#FF24292E" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 极客工具页面 -->
                <ScrollViewer x:Name="PageGeek" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="极客工具" FontSize="20" FontWeight="Bold" Foreground="#FF000000" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="增强功能模块" FontSize="13" Foreground="#FF555555" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="极域 UDP 攻击" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,4" />
                                <TextBlock Text="开发中..." FontSize="12" Foreground="#FF888888" />
                            </StackPanel>
                        </Border>
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="小小私聊" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,4" />
                                <TextBlock Text="开发中..." FontSize="12" Foreground="#FF888888" />
                            </StackPanel>
                        </Border>
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="截图替换" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,4" />
                                <TextBlock Text="开发中..." FontSize="12" Foreground="#FF888888" />
                            </StackPanel>
                        </Border>
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="教师端模拟" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,4" />
                                <TextBlock Text="开发中..." FontSize="12" Foreground="#FF888888" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 软件高级设置页面 -->
                <Grid x:Name="PageAdvancedSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnBackFromAdvanced" Content="← 返回" Style="{StaticResource GlassButton}" Click="BtnBackFromAdvanced_Click" Background="#FF6C757D" Padding="12,6" />
                        <TextBlock Grid.Column="1" Text="软件高级参数配置" FontSize="18" FontWeight="Bold" Foreground="#FF0A0A0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 内容区域 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,8">
                            <!-- 驱动设置 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="驱动设置" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckDisableDriver" Content="禁用软件内核驱动" Style="{StaticResource GlassCheckBox}" ToolTip="禁用后将不加载内核驱动，部分功能不可用" />
                                    <CheckBox x:Name="CheckSelfProtect" Content="驱动层自我保护" Style="{StaticResource GlassCheckBox}" ToolTip="通过驱动防止本软件被结束" />
                                    <TextBlock x:Name="DriverHintText" Text="注：需先在设置页面加载内核驱动" FontSize="11" Foreground="#FF666666" Margin="4,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 极域附加控制 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="极域附加控制" FontSize="14" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckAutoForceKill" Content="不客气模式（自动强制清除）" Style="{StaticResource GlassCheckBox}" ToolTip="操作失败时直接清除极域有关进程，不建议使用" />
                                    <CheckBox x:Name="CheckAutoIncludeFullWindow" Content="严格窗口控制模式" Style="{StaticResource GlassCheckBox}" ToolTip="严格控制极域所有窗口，不仅仅是屏幕广播和黑屏窗口" />
                                </StackPanel>
                            </Border>

                            <!-- 程序隐藏 -->
