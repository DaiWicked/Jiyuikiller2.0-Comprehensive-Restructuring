                                            <Button x:Name="BtnWallpaperApply" Content="应用壁纸" Style="{StaticResource GlassButton}" Click="BtnWallpaperApply_Click" Padding="12,6" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Background="#FF28A745" Foreground="White" />
                                            <Button x:Name="BtnWallpaperReset" Content="恢复默认" Style="{StaticResource GlassButton}" Click="BtnWallpaperReset_Click" Padding="12,6" FontSize="12" HorizontalAlignment="Left" Background="#FFDC3545" Foreground="White" />
