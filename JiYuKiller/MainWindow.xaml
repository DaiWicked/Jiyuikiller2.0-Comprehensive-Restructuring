<Window x:Class="JiYuKiller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="学习不通"
        Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/JiYuTrainerLogo.ico"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        MinWidth="400" MinHeight="450">

    <Window.Resources>
        <!-- 页面切换动画 -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>
    </Window.Resources>

    <!-- 外层玻璃容器（半透明背景，不使用BlurEffect避免模糊文字） -->
    <Border x:Name="GlassContainer" CornerRadius="16" Margin="8">
        <Border.Background>
            <SolidColorBrush x:Name="GlassBgBrush" Color="#E6FFFFFF" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#60FFFFFF" />
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#40000000" Opacity="0.4" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- 标题栏（整行可拖动，Background=Transparent确保空白区域也接收鼠标事件） -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/JiYuTrainerLogo16.png" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="学习不通" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF333333" />
                    <TextBlock x:Name="VersionText" Text="QD_V2.0" FontSize="11" VerticalAlignment="Center" Foreground="#FF888888" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="BtnMinimize" Content="─" Width="32" Height="28" Click="BtnMinimize_Click" Style="{StaticResource GlassButton}" Padding="0" FontSize="12" Background="Transparent" Foreground="#FF666666" BorderBrush="Transparent" />
                    <Button x:Name="BtnClose" Content="✕" Width="32" Height="28" Click="BtnClose_Click" Style="{StaticResource GlassButton}" Padding="0" FontSize="12" Background="Transparent" Foreground="#FF666666" BorderBrush="Transparent" />
                </StackPanel>
            </Grid>

            <!-- 内容区域 -->
            <Grid Grid.Row="1" Margin="16,8">

                <!-- 设置页面 -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        <!-- 状态显示卡片 -->
                        <Border Background="#20000000" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="当前状态" FontSize="11" Foreground="#FF888888" />
                                <TextBlock x:Name="StatusText" Text="正在初始化..." FontSize="18" FontWeight="Bold" Foreground="#FF333333" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 进程控制分组 -->
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="进程控制" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckMonitorProcess" Content="监控极域运行进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="监控极域运行进程，教师可通过极域远程执行应用程序" />
                                <CheckBox x:Name="CheckBanRunOp" Content="禁止极域运行进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域在此电脑上运行程序" />
                                <CheckBox x:Name="CheckProhibitKill" Content="禁止极域结束进程" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域结束您电脑上的进程" />
                            </StackPanel>
                        </Border>

                        <!-- 窗口控制分组 -->
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="窗口控制" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckAllowTop" Content="允许屏幕广播窗口置顶" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许屏幕广播窗口置顶，默认不允许" />
                                <CheckBox x:Name="CheckProhibitClose" Content="禁止极域关闭窗口" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="禁止教师通过极域关闭您电脑上的窗口" />
                            </StackPanel>
                        </Border>

                        <!-- 教师权限分组 -->
                        <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="教师权限" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                <CheckBox x:Name="CheckAllowMonitor" Content="允许教师监视你的电脑" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许教师通过极域查看你的电脑屏幕" />
                                <CheckBox x:Name="CheckAllowControl" Content="允许老师控制你的电脑" Style="{StaticResource GlassCheckBox}" Checked="Setting_Checked" Unchecked="Setting_Unchecked" ToolTip="允许教师通过极域控制您的电脑" />
                            </StackPanel>
                        </Border>

                        <!-- 操作按钮 -->
                        <WrapPanel Margin="0,2,0,0">
                            <Button x:Name="BtnUnloadNetFilter" Content="解除网络控制" Style="{StaticResource GlassButton}" Click="BtnUnloadNetFilter_Click" Margin="0,0,6,6" />
                            <Button x:Name="BtnLocateJiYu" Content="选择极域路径" Style="{StaticResource GlassButton}" Click="BtnLocateJiYu_Click" Background="#FF6C757D" Margin="0,0,6,6" />
                            <Button x:Name="BtnAdvancedSettings" Content="软件高级设置" Style="{StaticResource GlassButton}" Click="BtnAdvancedSettings_Click" Background="#FF6F42C1" Margin="0,0,6,6" />
                            <Button x:Name="BtnSaveSettings" Content="保存设置" Style="{StaticResource GlassButton}" Click="BtnSaveSettings_Click" Background="#FF28A745" Margin="0,0,6,6" />
                            <Button x:Name="BtnResetSettings" Content="恢复默认" Style="{StaticResource GlassButton}" Click="BtnResetSettings_Click" Background="#FFFFC107" Foreground="#FF333333" Margin="0,0,6,6" />
                        </WrapPanel>

                        <!-- 极域路径显示 -->
                        <TextBlock x:Name="JiYuPathText" Text="极域路径: 未设置" FontSize="10" Foreground="#FF999999" Margin="4,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 关于页面 -->
                <Grid x:Name="PageAbout" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                            <Image Source="Assets/about.png" Width="280" Margin="0,0,0,16" Stretch="Uniform" />
                            <TextBlock Text="学习不通" FontSize="22" FontWeight="Bold" Foreground="#FF333333" HorizontalAlignment="Center" />
                            <TextBlock x:Name="AboutVersion" Text="QD_V2.0_JiYuRebuild-TEST" FontSize="13" Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,4,0,16" />
                            <TextBlock Text="基于 JiYuTrainer 重构的 C# WPF 版本" FontSize="11" Foreground="#FF666666" HorizontalAlignment="Center" />

                            <!-- 致谢 -->
                            <TextBlock Text="致谢" FontSize="14" FontWeight="Bold" Foreground="#FF333333" HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="原作者: imengyu" FontSize="11" Foreground="#FF666666" Margin="0,0,16,0" />
                                <TextBlock Text="二改作者: zsyn666" FontSize="11" Foreground="#FF666666" />
                            </StackPanel>

                            <!-- 关于我入口 -->
                            <Button x:Name="BtnAboutMe" Content="关于我" Style="{StaticResource GlassButton}" Click="BtnAboutMe_Click" Margin="0,20,0,0" Width="100" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 关于我页面 -->
                <Grid x:Name="PageAboutMe" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                            <!-- 返回按钮 -->
                            <Button x:Name="BtnBackFromAboutMe" Content="← 返回" Style="{StaticResource GlassButton}" Click="BtnBackFromAboutMe_Click" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#FF6C757D" Padding="12,6" />

                            <!-- 头像 -->
                            <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,16" ClipToBounds="True">
                                <Image Source="Assets/me.png" Stretch="UniformToFill" />
                            </Border>

                            <!-- 标题 -->
                            <TextBlock Text="关于我" FontSize="22" FontWeight="Bold" Foreground="#FF333333" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="作者: Daitangxin" FontSize="14" Foreground="#FF555555" HorizontalAlignment="Center" Margin="0,0,0,16" />

                            <!-- 内容简介 -->
                            <Border Background="#20000000" CornerRadius="8" Padding="16" Margin="16,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="内容简介" FontSize="12" FontWeight="Bold" Foreground="#FF888888" Margin="0,0,0,8" />
                                    <TextBlock Text="创始人 / 程序员 / 摄影师" FontSize="13" Foreground="#FF333333" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="缺德组织 CEO" FontSize="13" Foreground="#FF333333" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="缺德组织核心人员之一" FontSize="13" Foreground="#FF333333" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- GitHub 链接 -->
                            <Button x:Name="BtnGithub" Content="GitHub 仓库" Style="{StaticResource GlassButton}" Click="BtnGithub_Click" Margin="0,16,0,0" Width="140" Background="#FF24292E" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 软件高级设置页面 -->
                <Grid x:Name="PageAdvancedSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnBackFromAdvanced" Content="← 返回" Style="{StaticResource GlassButton}" Click="BtnBackFromAdvanced_Click" Background="#FF6C757D" Padding="12,6" />
                        <TextBlock Grid.Column="1" Text="软件高级参数配置" FontSize="16" FontWeight="Bold" Foreground="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 内容区域 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,8">
                            <!-- 驱动设置 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="驱动设置（需内核驱动支持）" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckDisableDriver" Content="禁用软件内核驱动" Style="{StaticResource GlassCheckBox}" IsEnabled="False" ToolTip="64位系统强制启用驱动，无法禁用" />
                                    <CheckBox x:Name="CheckSelfProtect" Content="驱动层自我保护（32位系统有效）" Style="{StaticResource GlassCheckBox}" IsEnabled="False" ToolTip="64位系统不支持驱动层自我保护" />
                                    <TextBlock Text="注：当前为64位系统，驱动相关设置暂不可用" FontSize="10" Foreground="#FF999999" Margin="4,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 极域附加控制 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="极域附加控制" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckAutoForceKill" Content="不客气模式（自动强制清除）" Style="{StaticResource GlassCheckBox}" ToolTip="操作失败时直接清除极域有关进程，不建议使用" />
                                    <CheckBox x:Name="CheckAutoIncludeFullWindow" Content="严格窗口控制模式" Style="{StaticResource GlassCheckBox}" ToolTip="严格控制极域所有窗口，不仅仅是屏幕广播和黑屏窗口" />
                                </StackPanel>
                            </Border>

                            <!-- 程序隐藏 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="程序隐藏" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckDoNotShowVirusWindow" Content="隐藏极域端控制输出窗口" Style="{StaticResource GlassCheckBox}" ToolTip="隐藏屏幕左上角的极域控制输出窗口" />
                                    <CheckBox x:Name="CheckDoNotShowTrayIcon" Content="隐藏本软件任务栏图标" Style="{StaticResource GlassCheckBox}" ToolTip="隐藏后可使用快捷键显示或隐藏主窗口" Checked="CheckDoNotShowTrayIcon_Checked" Unchecked="CheckDoNotShowTrayIcon_Unchecked" />
                                </StackPanel>
                            </Border>

                            <!-- 快捷键 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="快捷键（修改后重启生效）" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="紧急全屏快捷键" VerticalAlignment="Center" Foreground="#FF333333" FontSize="12" />
                                        <TextBlock x:Name="TextHotKeyFakeFull" Grid.Column="1" Text="Ctrl+Alt+F" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF555555" FontSize="12" />
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示/隐藏窗口快捷键" VerticalAlignment="Center" Foreground="#FF333333" FontSize="12" />
                                        <TextBlock x:Name="TextHotKeyShowHide" Grid.Column="1" Text="Ctrl+Alt+H" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FF555555" FontSize="12" />
                                    </Grid>
                                    <TextBlock Text="注：快捷键自定义功能开发中，当前使用默认快捷键" FontSize="10" Foreground="#FF999999" Margin="4,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 结束进程模式 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="结束进程模式" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <RadioButton x:Name="RadioKillTP" Content="TerminateProcess (Weak)" GroupName="KillProcess" Foreground="#FF333333" FontSize="12" Margin="0,2" />
                                    <RadioButton x:Name="RadioKillNTP" Content="NtTerminateProcess (Default)" GroupName="KillProcess" Foreground="#FF333333" FontSize="12" Margin="0,2" />
                                    <RadioButton x:Name="RadioKillKernel" Content="KernelMode (需驱动)" GroupName="KillProcess" Foreground="#FF333333" FontSize="12" Margin="0,2" IsEnabled="False" />
                                </StackPanel>
                            </Border>

                            <!-- 注入模式 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="病毒注入模式（需DLL支持）" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="注入模式:" VerticalAlignment="Center" Foreground="#FF333333" FontSize="12" Margin="0,0,8,0" />
                                        <ComboBox x:Name="ComboInjectMode" Grid.Column="1" Height="28" FontSize="12">
                                            <ComboBoxItem Content="RemoteThread" />
                                            <ComboBoxItem Content="HookDllStub" />
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="CheckInjectMasterHelper" Content="InjectMasterHelper" Style="{StaticResource GlassCheckBox}" IsEnabled="False" />
                                    <CheckBox x:Name="CheckInjectProcHelper64" Content="InjectProcHelper64" Style="{StaticResource GlassCheckBox}" IsEnabled="False" />
                                    <TextBlock Text="注：DLL注入功能开发中，设置项暂保存" FontSize="10" Foreground="#FF999999" Margin="4,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 高级程序配置 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="高级程序配置" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckAlwaysCheckUpdate" Content="总是检查更新" Style="{StaticResource GlassCheckBox}" />
                                    <CheckBox x:Name="CheckForceInstallInCurrentDir" Content="强制安装在当前目录" Style="{StaticResource GlassCheckBox}" />
                                    <CheckBox x:Name="CheckForceDisableWatchDog" Content="强制禁用看门狗" Style="{StaticResource GlassCheckBox}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="检查间隔(ms):" VerticalAlignment="Center" Foreground="#FF333333" FontSize="12" Margin="0,0,8,0" />
                                        <TextBox x:Name="TextCKInterval" Grid.Column="1" Text="3100" Style="{StaticResource GlassTextBox}" Height="26" FontSize="12" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="范围: 1000-10000" VerticalAlignment="Center" Foreground="#FF999999" FontSize="10" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 控制器启停 -->
                            <Border Background="#15000000" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="自动控制器启停" FontSize="13" FontWeight="Bold" Foreground="#FF555555" Margin="0,0,0,8" />
                                    <CheckBox x:Name="CheckEnableController" Content="启用控制器" Style="{StaticResource GlassCheckBox}" Checked="CheckEnableController_Checked" Unchecked="CheckEnableController_Unchecked" />
                                    <TextBlock Text="控制器负责检查和控制极域，关闭将导致极域脱离控制。不建议关闭，仅调试时使用。" FontSize="10" Foreground="#FF999999" Margin="4,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 保存按钮 -->
                            <Button x:Name="BtnSaveAdvancedSettings" Content="保存高级设置" Style="{StaticResource GlassButton}" Click="BtnSaveAdvancedSettings_Click" Background="#FF28A745" Margin="0,4,0,0" Height="36" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 调试页面 -->
                <Grid x:Name="PageDebug" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnRefreshLog" Content="刷新日志" Style="{StaticResource GlassButton}" Click="BtnRefreshLog_Click" Margin="0,0,8,0" />
                        <Button x:Name="BtnOpenLogFolder" Content="打开日志目录" Style="{StaticResource GlassButton}" Click="BtnOpenLogFolder_Click" Background="#FF6C757D" />
                        <CheckBox x:Name="CheckDebugMode" Content="调试模式" Style="{StaticResource GlassCheckBox}" Margin="16,0,0,0" Checked="DebugMode_Checked" Unchecked="DebugMode_Unchecked" />
                    </StackPanel>

                    <TextBox x:Name="DebugLogBox" Grid.Row="1"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#FF1E1E1E"
                             Foreground="#FFD4D4D4"
                             BorderBrush="#FF333333"
                             BorderThickness="1"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>

            </Grid>

            <!-- 底部导航栏 -->
            <Border Grid.Row="2" Background="#10000000" CornerRadius="0,0,16,16">
                <UniformGrid Columns="3">
                    <Button x:Name="NavSetting" Content="控制台和设置" Click="NavSetting_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF333333" BorderBrush="Transparent" FontWeight="Bold" />
                    <Button x:Name="NavDebug" Content="调试" Click="NavDebug_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF666666" BorderBrush="Transparent" />
                    <Button x:Name="NavAbout" Content="关于" Click="NavAbout_Click" Style="{StaticResource GlassButton}" Background="Transparent" Foreground="#FF666666" BorderBrush="Transparent" />
                </UniformGrid>
            </Border>

        </Grid>
    </Border>
</Window>
