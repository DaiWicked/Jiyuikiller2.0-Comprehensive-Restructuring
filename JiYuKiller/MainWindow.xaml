                                    <TextBlock x:Name="TextNavLensStatus" Text="" FontSize="11" Foreground="#FF404040" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            
                            <!-- 自定义壁纸 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="自定义壁纸" FontSize="14" FontWeight="Bold" Foreground="#FF0A0A0A" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
