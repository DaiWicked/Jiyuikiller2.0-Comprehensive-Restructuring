                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderBlurIntensity" Grid.Column="0" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1" Value="0.8" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="SliderBlurIntensity_ValueChanged" />
                                            <TextBlock x:Name="TextBlurValue" Grid.Column="1" Text="80%" FontSize="12" Foreground="#FF1A1A1A" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,8">
