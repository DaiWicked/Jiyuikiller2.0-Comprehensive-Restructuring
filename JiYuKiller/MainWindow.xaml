                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderContentOpacity" Grid.Column="0" Style="{StaticResource GlassSlider}" Minimum="0.05" Maximum="1" Value="0.25" TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="SliderContentOpacity_ValueChanged" ToolTip="0% = 白纱最厚（自定义壁纸清晰）&#x0a;100% = 白纱消失（壁纸被遮住，直接显示桌面）" />
                                            <TextBlock x:Name="TextContentOpacityValue" Grid.Column="1" Text="25%" FontSize="12" Foreground="#FF1A1A1A" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="一个值同时决定三件事：白纱厚度、自定义壁纸的可见度、滑块位置。" FontSize="11" Foreground="#FF383838" TextWrapping="Wrap" Margin="0,6,0,0" />
