                                    <TextBlock Text="说明" FontSize="13" FontWeight="Bold" Foreground="#FF0A0A0A" Margin="0,0,0,6" />
                                    <TextBlock Text="• 毛玻璃效果通过桌面截图 + 像素着色器实现" FontSize="11" Foreground="#FF3A3A3A" TextWrapping="Wrap" Margin="0,0,0,3" />
                                    <TextBlock Text="• 移动窗口后自动刷新背景" FontSize="11" Foreground="#FF3A3A3A" TextWrapping="Wrap" Margin="0,0,0,3" />
                                    <TextBlock Text="• 模糊强度越高，玻璃效果越明显" FontSize="11" Foreground="#FF3A3A3A" TextWrapping="Wrap" Margin="0,0,0,3" />
                                    <TextBlock Text="• 内容层透明度越低，背景越清晰" FontSize="11" Foreground="#FF3A3A3A" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 调试页面 -->
                <Grid x:Name="PageDebug" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnRefreshLog" Content="刷新日志" Style="{StaticResource GlassButton}" Click="BtnRefreshLog_Click" Margin="0,0,6,0" Padding="10,5" FontSize="12" />
                        <Button x:Name="BtnOpenLogFolder" Content="打开日志目录" Style="{StaticResource GlassButton}" Click="BtnOpenLogFolder_Click" Background="#FF6C757D" Margin="0,0,6,0" Padding="10,5" FontSize="12" />
                        <CheckBox x:Name="CheckDebugMode" Content="调试模式" Style="{StaticResource GlassCheckBox}" Margin="8,0,0,0" FontSize="12" Checked="DebugMode_Checked" Unchecked="DebugMode_Unchecked" />
                    </StackPanel>

                    <!-- 调试命令 -->
                    <Border Grid.Row="1" Background="#15000000" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="调试命令" FontSize="13" FontWeight="Bold" Foreground="#FF2A2A2A" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TextDebugCmd" Grid.Column="0" Style="{StaticResource GlassTextBox}" Height="28" FontSize="13" VerticalContentAlignment="Center" KeyDown="TextDebugCmd_KeyDown" ToolTip="输入 help 查看可用命令" />
                                <Button x:Name="BtnRunCmd" Grid.Column="1" Content="执行" Style="{StaticResource GlassButton}" Click="BtnRunCmd_Click" Background="#FF007BFF" Margin="6,0,0,0" Padding="14,5" FontSize="12" />
                            </Grid>
                            <TextBlock Text="输入 help 查看可用命令，按回车快速执行" FontSize="11" Foreground="#FF666666" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 日志显示 -->
                    <TextBox x:Name="DebugLogBox" Grid.Row="2"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#FF1E1E1E"
                             Foreground="#FFD4D4D4"
                             BorderBrush="#FF0A0A0A"
                             BorderThickness="1"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>

            </Grid>

            <!-- 底部悬浮导航栏（液态玻璃） -->
            <Grid Grid.Row="2" Margin="10,2,10,12" HorizontalAlignment="Center" Height="56">
                <!-- 层1: 外阴影（悬浮感） -->
                <Border CornerRadius="28" Background="#2E000000" Margin="0,5,0,-3" Opacity="0.7">
                    <Border.Effect><BlurEffect Radius="14" /></Border.Effect>
                </Border>
                <!-- 层2: 外层光晕（液态膨胀） -->
                <Border CornerRadius="28" Background="#40A8D0F0" Margin="-4" Opacity="0.5">
                    <Border.Effect><BlurEffect Radius="16" /></Border.Effect>
                </Border>
                <!-- 层3: 边缘折射边框 -->
                <Border CornerRadius="26" BorderThickness="1.5">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D0FFFFFF" Offset="0" />
                            <GradientStop Color="#70FFFFFF" Offset="0.25" />
                            <GradientStop Color="#30FFFFFF" Offset="0.6" />
                            <GradientStop Color="#90B0C8D8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <!-- 层4: 玻璃主体 -->
                    <Border CornerRadius="24" Padding="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#55FFFFFF" Offset="0" />
                                <GradientStop Color="#38FFFFFF" Offset="0.5" />
                                <GradientStop Color="#28FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <!-- 层5: 顶部高光 -->
                            <Border CornerRadius="24,24,0,0" Height="18" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#70FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- 可横向滚动的导航区域（指示器和按钮同坐标系） -->
                            <ScrollViewer x:Name="NavScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="2,0">
                                <Grid x:Name="NavContentGrid" HorizontalAlignment="Left">
                                    <!-- 滑动指示器（微妙背景高亮，不遮挡文字） -->
                                    <Border x:Name="NavIndicator" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Height="40" CornerRadius="16" Margin="0" Width="52" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#40FFFFFF" Offset="0" />
                                                <GradientStop Color="#20FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="NavIndicatorTransform" X="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <!-- 导航按钮 -->
                                    <StackPanel Orientation="Horizontal" x:Name="NavStackPanel">
                                        <Button x:Name="NavQuick" Content="快捷栏" Click="NavQuick_Click" Style="{StaticResource NavGlassButton}" Padding="10,5" Margin="2,0" MinWidth="52" Height="44" />
                                        <Button x:Name="NavSetting" Content="控制台和设置" Click="NavSetting_Click" Style="{StaticResource NavGlassButton}" Padding="10,5" Margin="2,0" MinWidth="72" Height="44" />
                                        <Button x:Name="NavCustom" Content="自定义设置" Click="NavCustom_Click" Style="{StaticResource NavGlassButton}" Padding="10,5" Margin="2,0" MinWidth="62" Height="44" />
                                        <Button x:Name="NavGeek" Content="极客工具" Click="NavGeek_Click" Style="{StaticResource NavGlassButton}" Padding="10,5" Margin="2,0" MinWidth="52" Height="44" />
                                        <Button x:Name="NavHelp" Content="帮助文档" Click="NavHelp_Click" Style="{StaticResource NavGlassButton}" Padding="10,5" Margin="2,0" MinWidth="52" Height="44" />
                                        <Button x:Name="NavDebug" Content="调试" Click="NavDebug_Click" Style="{StaticResource NavGlassButton}" Padding="10,5" Margin="2,0" MinWidth="44" Height="44" />
                                        <Button x:Name="NavAbout" Content="关于" Click="NavAbout_Click" Style="{StaticResource NavGlassButton}" Padding="10,5" Margin="2,0" MinWidth="44" Height="44" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

                </Grid>
            </Border>

            <!-- 层4: 光感效果（渐变边框 + 顶部高光，不响应鼠标事件） -->
            <Border CornerRadius="16" BorderThickness="1.5" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A0FFFFFF" Offset="0" />
                        <GradientStop Color="#50A6E1FF" Offset="0.35" />
                        <GradientStop Color="#50FFB3E1" Offset="0.65" />
                        <GradientStop Color="#A0FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <!-- 顶部高光 -->
            <Border CornerRadius="16,16,0,0" Height="40" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#60FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
