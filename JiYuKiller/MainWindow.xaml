                <!-- 极域教师端模拟页面 -->
                <ScrollViewer x:Name="PageTeacherSim" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <StackPanel Margin="16,12">
                        <!-- 标题栏 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="←" Click="BtnTeacherSimBack_Click" Style="{StaticResource GlassButton}" Width="36" Height="32" FontSize="14" Padding="0" />
                            <TextBlock Grid.Column="1" Text="极域教师端模拟 (beta)" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FF1a1a2e" />
                        </Grid>

                        <!-- 状态和配置 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="TeacherSimStatusDot" Width="12" Height="12" Fill="#FF999999" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" x:Name="TextTeacherSimStatus" Text="未启动" FontSize="14" FontWeight="Bold" Foreground="#FF404040" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="频道:" FontSize="12" Foreground="#FF555566" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" x:Name="TextTeacherSimChannel" Text="1" Style="{StaticResource GlassTextBox}" FontSize="12" Padding="6,4" Height="28" Width="60" HorizontalAlignment="Left" />
                                </Grid>
                                <TextBlock x:Name="TextTeacherSimInfo" Text="本机IP: 获取中..." FontSize="11" Foreground="#FF888899" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 兼容性告示 -->
                        <Border Background="#20FFD700" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#60FFD700" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚠ 兼容性提示" FontSize="12" FontWeight="Bold" Foreground="#FFDAA520" Margin="0,0,0,4" />
                                <TextBlock Text="teacher_sim 在 32位 Windows 7 下可能因 PyInstaller 中文路径问题启动失败。建议：将程序放在纯英文路径下运行，或使用 Windows 10 及以上系统。" FontSize="11" Foreground="#FFC0C0C0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 已登录学生列表 -->
                        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="已登录学生" FontSize="13" FontWeight="Bold" Foreground="#FF1a1a2e" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="刷新" Click="BtnTeacherSimRefreshList_Click" Style="{StaticResource GlassButton}" Background="#FF007AFF" Height="26" FontSize="11" Padding="8,0" />
                                </Grid>
                                <ListBox x:Name="ListTeacherSimStudents" Height="120" Background="#FF0A0A0A" Foreground="#FF00FF00" FontSize="11" FontFamily="Consolas" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionChanged="ListTeacherSimStudents_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="6,3" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- 模拟控制台 + 日志输出（上下布局） -->
                        <Border Background="#FF0A0A0A" CornerRadius="10" Padding="8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="120" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                <TextBlock Text="模拟控制台" FontSize="12" FontWeight="Bold" Foreground="#FF00FF00" Margin="0,0,0,4" />
                                <TextBox x:Name="TextTeacherSimConsole" Background="#FF000000" Foreground="#FF00FF00" FontSize="11" FontFamily="Consolas" Height="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" IsReadOnly="True" Padding="4" BorderThickness="0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
