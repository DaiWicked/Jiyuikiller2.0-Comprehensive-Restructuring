<CheckBox x:Name="CheckNavSquircle" Content="圆角使用超椭圆(squircle，更顺滑)" Style="{StaticResource GlassCheckBox}" Checked="NavLensSetting_Changed" Unchecked="NavLensSetting_Changed" Margin="0,0,0,6" />
