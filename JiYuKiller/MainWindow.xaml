                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderNavLensStrength" Grid.Column="0" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1" Value="0.35" TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="SliderNavLensStrength_ValueChanged" />
