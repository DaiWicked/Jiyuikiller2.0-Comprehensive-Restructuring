                                </StackPanel>
                            </Border>

<!-- 说明 -->
                            <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="说明" FontSize="13" FontWeight="Bold" Foreground="#FF0A0A0A" Margin="0,0,0,6" />
